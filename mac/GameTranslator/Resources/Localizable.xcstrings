          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مُعدّ"
          }
        }
      }
    },
    "Connect a TV": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağla"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط تلفزيوناً"
          }
        }
      }
    },
    "No TV? Show on the computer screen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No TV? Show on the computer screen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'm yok, bilgisayar ekranında göster"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تلفزيون؟ اعرض على شاشة الكمبيوتر"
          }
        }
      }
    },
    "Subtitles appear in a window over the game or PS Remote Play. You can connect a TV later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles appear in a window over the game or PS Remote Play. You can connect a TV later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı oyunun ya da PS Remote Play'in üstünde bir pencerede görünür. TV'yi sonra da bağlayabilirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الترجمة في نافذة فوق اللعبة أو PS Remote Play. يمكنك ربط تلفزيون لاحقاً."
          }
        }
      }
    },
    "GameTranslator will show a sample subtitle on this computer's screen, at the bottom.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator will show a sample subtitle on this computer's screen, at the bottom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator bu bilgisayarın ekranında, altta örnek bir altyazı gösterecek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعرض GameTranslator ترجمة تجريبية أسفل شاشة هذا الكمبيوتر."
          }
        }
      }
    },
    "Do you see it on the screen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you see it on the screen?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranda görüyor musunuz?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تراها على الشاشة؟"
          }
        }
      }
    },
    "If you don't see it, send it again. It shows for a few seconds at the bottom of the screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't see it, send it again. It shows for a few seconds at the bottom of the screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görmüyorsanız yeniden gönderin. Altyazı ekranın altında birkaç saniye görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم ترها فأرسلها مرة أخرى. تظهر لثوانٍ أسفل الشاشة."
          }
        }
      }
    },
    "Subtitles appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles appear here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı burada görünecek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الترجمة هنا."
          }
        }
      }
    },
    "Drag to move, drag the edges to resize.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move, drag the edges to resize."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleyerek taşıyın, kenarlardan genişletin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للتحريك، واسحب الحواف لتغيير الحجم."
          }
        }
      }
    },
    "Open GameTranslator": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open GameTranslator"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator'ı aç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح GameTranslator"
          }
        }
      }
    },
    "Game packs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game packs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun paketleri"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزم الألعاب"
          }
        }
      }
    },
    "Use game packs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use game packs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun paketlerini kullan"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حزم الألعاب"
          }
        }
      }
    },
    "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı oyunlar için hazır Türkçe çeviriler. Pakette bulunan satır, çeviri motoruna gitmeden hemen görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمات تركية جاهزة لبعض الألعاب. لا تُستخدم مع الترجمة العربية."
          }
        }
      }
    },
    "No game pack is installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No game pack is installed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü oyun paketi yok."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد حزمة لعبة مثبّتة."
          }
        }
      }
    },
    "%1$@ · %2$@ lines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ lines"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ satır"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ جملة"
          }
        }
      }
    },
    "Send the English subtitles read to the shared pool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the English subtitles read to the shared pool"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunan İngilizce altyazıları ortak havuza gönder"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الترجمة الإنجليزية المقروءة إلى المجمّع المشترك"
          }
        }
      }
    },
    "Only the game's English text is sent, anonymously. It is used to make better Turkish translations for everyone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the game's English text is sent, anonymously. It is used to make better Turkish translations for everyone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız oyunun İngilizce metni anonim olarak gönderilir. Herkes için daha iyi Türkçe çeviriler hazırlamakta kullanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل نص اللعبة الإنجليزي فقط، بلا هوية، لتحسين الترجمات التركية. في النسخة العربية هذا الإرسال متوقف دائماً."
          }
        }
      }
    },
    "GameTranslator sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator, okuduğu İngilizce altyazıları anonim olarak ortak havuza gönderir; böylece herkes için daha iyi Türkçe çeviriler hazırlanır. Ayarlar'dan kapatabilirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة الأصلية ترسل الترجمة الإنجليزية المقروءة إلى مجمّع مشترك لتحسين الترجمات التركية. في النسخة العربية هذا الإرسال متوقف دائماً."
          }
        }
      }
    },
    "No PS5 found. Make sure it is on and on the same network, or enter its IP address. GameTranslator must also be allowed in System Settings › Privacy & Security › Local Network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PS5 found. Make sure it is on and on the same network, or enter its IP address. GameTranslator must also be allowed in System Settings › Privacy & Security › Local Network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bulunamadı. Açık ve aynı ağda olduğundan emin olun ya da IP adresini girin. GameTranslator'ın Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ'da da açık olması gerekir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على PS5. تأكد أنه مشغّل وعلى نفس الشبكة، أو أدخل عنوان IP الخاص به. ويجب السماح لـGameTranslator من إعدادات النظام › الخصوصية والأمان › الشبكة المحلية."
          }
        }
      }
    },
    "Connecting to the PS5… This can take up to 30 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to the PS5… This can take up to 30 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'e bağlanılıyor… Bu 30 saniye kadar sürebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال بالـPS5… قد يستغرق حتى 30 ثانية."
          }
        }
      }
    },
    "The code is wrong or has expired. Open Pair Device again on the PS5 and enter the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is wrong or has expired. Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod yanlış ya da süresi dolmuş. PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز خاطئ أو انتهت صلاحيته. افتح «ربط جهاز» من جديد في الـPS5 وأدخل الرمز الجديد."
          }
        }
      }
    },
    "The PS5 received the request but did not answer in time. Open Pair Device again on the PS5 and enter the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 received the request but did not answer in time. Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 isteği aldı ama zamanında yanıt vermedi. PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلم الـPS5 الطلب لكنه لم يرد في الوقت. افتح «ربط جهاز» من جديد في الـPS5 وأدخل الرمز الجديد."
          }
        }
      }
    },
    "No PS5 found at this address. Check the PS5's IP address under Settings › Network › Connection Status.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PS5 found at this address. Check the PS5's IP address under Settings › Network › Connection Status."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste PS5 bulunamadı. PS5'in IP adresini Ayarlar › Ağ › Bağlantı Durumu'ndan kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد PS5 على هذا العنوان. تحقق من عنوان IP للـPS5 من الإعدادات › الشبكة › حالة الاتصال."
          }
        }
      }
    },
    "macOS blocked the connection to the local network. Turn on GameTranslator in System Settings › Privacy & Security › Local Network, then enter a new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked the connection to the local network. Turn on GameTranslator in System Settings › Privacy & Security › Local Network, then enter a new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yerel ağ bağlantısını engelledi. Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ'da GameTranslator'ı açın, sonra yeni kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع macOS الاتصال بالشبكة المحلية. فعّل GameTranslator من إعدادات النظام › الخصوصية والأمان › الشبكة المحلية، ثم أدخل رمزاً جديداً."
          }
        }
      }
    },
    "If this keeps happening, send us this file: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this keeps happening, send us this file: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun sürerse şu dosyayı bize gönderin: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تكرر هذا فأرسل لنا هذا الملف: %@"
          }
        }
      }
    },
    "Show log file": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show log file"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük dosyasını göster"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض ملف السجل"
          }
        }
      }
    },
    "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony girişi tamamlamadı. Bir dakika bekleyin, sonra Giriş yap'a yeniden basıp ikinci hesapla giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُكمل Sony تسجيل الدخول. انتظر دقيقة، ثم اضغط «تسجيل الدخول» من جديد وادخل بالحساب الثاني."
          }
        }
      }
    },
    "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony çok fazla giriş denemesi aldı. Yaklaşık 15 dakika bekleyip yeniden giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلمت Sony محاولات دخول كثيرة. انتظر نحو 15 دقيقة ثم سجّل الدخول من جديد."
          }
        }
      }
    },
    "Sony's sign-in server returned an error. Wait a few minutes, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in server returned an error. Wait a few minutes, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusu hata verdi. Birkaç dakika bekleyip yeniden giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد خادم دخول Sony خطأ. انتظر بضع دقائق ثم سجّل الدخول من جديد."
          }
        }
      }
    },
    "Could not reach Sony's sign-in server. Check the internet connection, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Sony's sign-in server. Check the internet connection, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusuna ulaşılamadı. İnternet bağlantısını kontrol edip yeniden giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خادم دخول Sony. تحقق من الاتصال بالإنترنت ثم سجّل الدخول من جديد."
          }
        }
      }
    },
    "Sony's answer could not be read. Sign in again; if it keeps happening, update GameTranslator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's answer could not be read. Sign in again; if it keeps happening, update GameTranslator."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin yanıtı okunamadı. Yeniden giriş yapın; sürerse GameTranslator'ı güncelleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة رد Sony. سجّل الدخول من جديد؛ وإن تكرر فحدّث GameTranslator."
          }
        }
      }
    },
    "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş penceresi giriş bitmeden kapandı. Giriş yap'a basıp girişi pencerede tamamlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلقت نافذة تسجيل الدخول قبل اكتماله. اضغط «تسجيل الدخول» وأكمل الدخول في النافذة."
          }
        }
      }
    },
    "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sayfası açılamadı. İnternet bağlantısını kontrol edip yeniden giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل صفحة دخول Sony. تحقق من الاتصال بالإنترنت ثم سجّل الدخول من جديد."
          }
        }
      }
    },
    "Paired with %@. Connects when you start translating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with %@. Connects when you start translating."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile eşleşti. Çeviriyi başlatınca bağlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقترن مع %@. يتصل عند بدء الترجمة."
          }
        }
      }
    },
    "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 %@ adresinde bulunamadı. Açık ve aynı ağda olduğundan emin olun. Yeniden bağlanılıyor…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على الـPS5 في %@. تأكد أنه مشغّل وعلى نفس الشبكة. جارٍ إعادة الاتصال…"
          }
        }
      }
    },
    "Can't reach the PS5. Reconnecting…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the PS5. Reconnecting…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'e ulaşılamıyor. Yeniden bağlanılıyor…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الـPS5. جارٍ إعادة الاتصال…"
          }
        }
      }
    },
    "Reconnecting… (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting… (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden bağlanılıyor… (%@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إعادة الاتصال… (%@)"
          }
        }
      }
    },
    "Picture mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture mode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü modu"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع الصورة"
          }
        }
      }
    },
    "Inside the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside the app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama içinde"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "داخل التطبيق"
          }
        }
      }
    },
    "Overlay (for a black screen)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay (for a black screen)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katman (siyah ekran sorunu için)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طبقة فوقية (للشاشة السوداء)"
          }
        }
      }
    },
    "If the PS5 picture stays black inside the GameTranslator TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If the picture never arrives, the TV app switches to Overlay by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the PS5 picture stays black inside the GameTranslator TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If the picture never arrives, the TV app switches to Overlay by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 görüntüsü GameTranslator TV uygulamasının içinde siyah kalıyorsa Katman'ı seçin: TV, PS5'i kendi HDMI girişinde gösterir, altyazı görüntünün üstünde çıkar. Görüntü hiç gelmezse TV uygulaması kendiliğinden Katman'a geçer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا بقيت صورة الـPS5 سوداء داخل تطبيق GameTranslator على التلفزيون فاختر «طبقة فوقية»: يعرض التلفزيون الـPS5 على مدخل HDMI الخاص به وتظهر الترجمة فوقه. وإن لم تصل الصورة أبداً ينتقل التطبيق إلى الطبقة الفوقية تلقائياً."
          }
        }
      }
    },
    "Copy the link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the link"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kopyala"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ الرابط"
          }
        }
      }
    },
    "Details:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntı:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفاصيل:"
          }
        }
      }
    },
    "If the TV shows “Server under maintenance”, it cannot reach Samsung's servers: check the TV's internet connection and its date and time, restart the TV and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the TV shows “Server under maintenance”, it cannot reach Samsung's servers: check the TV's internet connection and its date and time, restart the TV and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de “Sunucu bakım altında” yazıyorsa TV, Samsung'un sunucularına ulaşamıyor: TV'nin internet bağlantısını, tarih ve saatini kontrol edin, TV'yi yeniden başlatıp tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا عرض التلفزيون «Server under maintenance» فهو لا يصل إلى خوادم سامسونج: تحقق من اتصال التلفزيون بالإنترنت ومن تاريخه ووقته، أعد تشغيله وحاول مرة أخرى."
          }
        }
      }
    },
    "If the sign-in window does not open, the browser may have blocked it as a pop-up: allow pop-ups for this page from the icon in the address bar, then press Open the page again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the sign-in window does not open, the browser may have blocked it as a pop-up: allow pop-ups for this page from the icon in the address bar, then press Open the page again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş penceresi açılmazsa tarayıcı onu açılır pencere diye engellemiş olabilir: adres çubuğundaki simgeden bu sayfa için açılır pencerelere izin verin, sonra Sayfayı yeniden aç'a basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تفتح نافذة تسجيل الدخول فربما حجبها المتصفح كنافذة منبثقة: اسمح بالنوافذ المنبثقة لهذه الصفحة من الأيقونة في شريط العنوان، ثم اضغط «افتح الصفحة مرة أخرى»."
          }
        }
      }
    },
    "A GameTranslator TV app signed on another computer is still on the TV and could not be removed. On the TV, open Apps, select GameTranslator, delete it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A GameTranslator TV app signed on another computer is still on the TV and could not be removed. On the TV, open Apps, select GameTranslator, delete it and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de başka bir bilgisayarda imzalanmış bir GameTranslator uygulaması var ve kaldırılamadı. TV'de Uygulamalar'ı açın, GameTranslator'ı seçip silin ve tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال على التلفزيون تطبيق GameTranslator موقّع من كمبيوتر آخر وتعذّر حذفه. في التلفزيون افتح التطبيقات، اختر GameTranslator واحذفه ثم حاول مرة أخرى."
          }
        }
      }
    },
    "The TV did not accept the signing certificate. Make sure the TV is connected to the internet (it checks the certificate with Samsung) and its date and time are right (Settings › General › System Manager › Time), then try again. GameTranslator gets a new certificate, so you sign in to Samsung once more.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV did not accept the signing certificate. Make sure the TV is connected to the internet (it checks the certificate with Samsung) and its date and time are right (Settings › General › System Manager › Time), then try again. GameTranslator gets a new certificate, so you sign in to Samsung once more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV imza sertifikasını kabul etmedi. TV'nin internete bağlı olduğundan (sertifikayı Samsung'a sorar) ve tarih ile saatinin doğru olduğundan emin olun (Ayarlar › Genel › Sistem Yöneticisi › Saat), sonra tekrar deneyin. GameTranslator yeni sertifika alacağı için Samsung hesabınızla bir kez daha giriş yaparsınız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل التلفزيون شهادة التوقيع. تأكد أن التلفزيون متصل بالإنترنت (يتحقق من الشهادة مع سامسونج) وأن تاريخه ووقته صحيحان (الإعدادات › عام › مدير النظام › الوقت)، ثم حاول مرة أخرى. GameTranslator يحصل على شهادة جديدة، فتسجّل الدخول في سامسونج مرة أخرى."
          }
        }
      }
    },
    "The TV's clock is behind, so the new certificate is not valid for it yet. Set the TV's date and time (Settings › General › System Manager › Time) or wait a few minutes, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV's clock is behind, so the new certificate is not valid for it yet. Set the TV's date and time (Settings › General › System Manager › Time) or wait a few minutes, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nin saati geride olduğu için yeni sertifika TV'ye göre henüz geçerli değil. TV'nin tarih ve saatini düzeltin (Ayarlar › Genel › Sistem Yöneticisi › Saat) ya da birkaç dakika bekleyip tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعة التلفزيون متأخرة، فالشهادة الجديدة غير صالحة له بعد. اضبط تاريخ التلفزيون ووقته (الإعدادات › عام › مدير النظام › الوقت) أو انتظر بضع دقائق ثم حاول مرة أخرى."
          }
        }
      }
    },
    "The TV refuses GameTranslator because an earlier GameTranslator is still registered on it (Tizen error 118, -22), even if it no longer appears among the apps. If GameTranslator is among the TV's apps, delete it there and try again. Otherwise reset Smart Hub (Settings › Support › Device Care › Self Diagnosis › Reset Smart Hub; menu names differ a little by model) and try again. Resetting Smart Hub also removes the other apps you downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV refuses GameTranslator because an earlier GameTranslator is still registered on it (Tizen error 118, -22), even if it no longer appears among the apps. If GameTranslator is among the TV's apps, delete it there and try again. Otherwise reset Smart Hub (Settings › Support › Device Care › Self Diagnosis › Reset Smart Hub; menu names differ a little by model) and try again. Resetting Smart Hub also removes the other apps you downloaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV, daha önceki bir GameTranslator'ın kaydı hâlâ durduğu için uygulamayı kabul etmiyor (Tizen hatası 118, -22); uygulama listede görünmese de. GameTranslator TV'nin uygulamaları arasındaysa oradan silip tekrar deneyin. Değilse Smart Hub'ı sıfırlayıp (Ayarlar › Destek › Cihaz Bakımı › Kendi Kendine Tanılama › Smart Hub'ı Sıfırla; menü adları modele göre biraz değişir) tekrar deneyin. Smart Hub'ı sıfırlamak, indirdiğiniz diğer uygulamaları da kaldırır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التلفزيون يرفض GameTranslator لأن نسخة سابقة منه ما زالت مسجّلة فيه (خطأ Tizen 118، -22) حتى لو لم تعد تظهر بين التطبيقات. إن كان GameTranslator بين تطبيقات التلفزيون فاحذفه هناك وحاول مرة أخرى. وإلا فأعد ضبط Smart Hub (الإعدادات › الدعم › العناية بالجهاز › التشخيص الذاتي › إعادة ضبط Smart Hub؛ أسماء القوائم تختلف قليلاً بين الموديلات) وحاول مرة أخرى. إعادة ضبط Smart Hub تحذف أيضاً التطبيقات الأخرى التي نزّلتها."
          }
        }
      }
    },
    "The connection to the TV dropped during the install. Keep the TV on and on the same network as this computer, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the TV dropped during the install. Keep the TV on and on the same network as this computer, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum sırasında TV bağlantısı koptu. TV'yi açık ve bu bilgisayarla aynı ağda tutup tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بالتلفزيون أثناء التثبيت. أبقِ التلفزيون مشغّلاً وعلى نفس شبكة هذا الكمبيوتر، ثم حاول مرة أخرى."
          }
        }
      }
    },
    "1. On the TV, open Apps and scroll to the very bottom of the page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Apps and scroll to the very bottom of the page."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Uygulamalar ekranını açın ve sayfanın en altına inin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. في التلفزيون افتح التطبيقات (Apps) وانزل إلى آخر الصفحة."
          }
        }
      }
    },
    "2. There, press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. There, press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Orada kumandada 1 2 3 4 5 tuşlarına basın (ya da ekran klavyesiyle 12345 yazın). Geliştirici modu penceresi açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. هناك اضغط 1 2 3 4 5 بالريموت (أو اكتب 12345 بلوحة الأرقام على الشاشة). تفتح نافذة وضع المطوّر."
          }
        }
      }
    },
    "The Samsung account page opened in your browser. Finish signing in there. If you do not see it, switch to the browser or press Open the page again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Samsung account page opened in your browser. Finish signing in there. If you do not see it, switch to the browser or press Open the page again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung hesabı penceresi tarayıcıda açıldı, girişi orada tamamlayın. Göremiyorsanız tarayıcıya geçin ya da Sayfayı yeniden aç'a basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُتحت صفحة حساب سامسونج في متصفحك. أكمل تسجيل الدخول هناك. إن لم ترها فانتقل إلى المتصفح أو اضغط «افتح الصفحة مرة أخرى»."
          }
        }
      }
    },
    "Samsung signs the app for your TV with your free Samsung account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung signs the app for your TV with your free Samsung account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung, uygulamayı ücretsiz Samsung hesabınızla TV'nize özel imzalar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سامسونج توقّع التطبيق لتلفزيونك بحسابك المجاني في سامسونج."
          }
        }
      }
    },
    "Accept the permission box on the TV with the remote (Allow). GameTranslator waits 60 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the permission box on the TV with the remote (Allow). GameTranslator waits 60 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de çıkan izin kutusunu kumandayla onaylayın (İzin ver). GameTranslator 60 saniye bekler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقبل مربع الإذن على التلفزيون بالريموت (Allow). GameTranslator ينتظر 60 ثانية."
          }
        }
      }
    },
    "The TV's permission box was not accepted within 60 seconds. If no box appeared, open the TV's home screen and press Connect again. If GameTranslator was denied before, allow it in Settings › General › External Device Manager › Device Connection Manager › Device List.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV's permission box was not accepted within 60 seconds. If no box appeared, open the TV's home screen and press Connect again. If GameTranslator was denied before, allow it in Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki izin kutusu 60 saniye içinde onaylanmadı. Kutu hiç çıkmadıysa TV'de ana ekranı açıp yeniden Bağlan'a basın. GameTranslator'a daha önce izin verilmediyse Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi'nden izin verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُقبل مربع الإذن على التلفزيون خلال 60 ثانية. إن لم يظهر مربع فافتح الشاشة الرئيسية للتلفزيون واضغط «اتصال» من جديد. وإن كان GameTranslator قد رُفض سابقاً فاسمح له من الإعدادات › عام › مدير الأجهزة الخارجية › مدير اتصال الأجهزة › قائمة الأجهزة."
          }
        }
      }
    },
    "The TV refused the connection. Allow GameTranslator in Settings › General › External Device Manager › Device Connection Manager › Device List on the TV, then press Connect again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV refused the connection. Allow GameTranslator in Settings › General › External Device Manager › Device Connection Manager › Device List on the TV, then press Connect again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağlantıyı reddetti. TV'de Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi'nden GameTranslator'a izin verip yeniden Bağlan'a basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض التلفزيون الاتصال. اسمح لـGameTranslator من الإعدادات › عام › مدير الأجهزة الخارجية › مدير اتصال الأجهزة › قائمة الأجهزة في التلفزيون، ثم اضغط «اتصال» من جديد."
          }
        }
      }
    },
