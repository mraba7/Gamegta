    "Open the Developer Mode app on the TV, turn on Key Server and keep the app on screen. Type the Passphrase it shows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Developer Mode app on the TV, turn on Key Server and keep the app on screen. Type the Passphrase it shows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de Developer Mode uygulamasını açın, Key Server'ı açın ve uygulamayı ekranda bırakın. Gösterdiği Passphrase'i buraya yazın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق Developer Mode على التلفزيون، شغّل Key Server وأبقِ التطبيق على الشاشة. اكتب عبارة المرور (Passphrase) التي يعرضها."
