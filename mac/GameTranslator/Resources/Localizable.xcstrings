    },
    "Something went wrong. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
