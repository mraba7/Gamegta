        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te Kullanıcı Ekle'yi seçin ve yeni hesapla bir kez oturum açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الـPS5 اختر «إضافة مستخدم» وسجّل الدخول مرة واحدة بالحساب الجديد."
          }
        }
      }
    },
    "On the TV": {
