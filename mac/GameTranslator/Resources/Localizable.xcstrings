    "The phone connects to the PS5 with Remote Play. Sign in with a free second PSN account, separate from the one you play with.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone connects to the PS5 with Remote Play. Sign in with a free second PSN account, separate from the one you play with."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon PS5'e Remote Play ile bağlanır. Oyunu oynadığın hesaptan ayrı, ücretsiz ikinci bir PSN hesabıyla giriş yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجوال يتصل بالـPS5 عبر Remote Play. سجّل الدخول بحساب PSN ثانٍ مجاني، غير الحساب الذي تلعب به."
          }
        }
      }
    },
