    "Copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalandı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ"
          }
        }
      }
    },
    "If OBS runs on another computer, use this Mac's network address instead of localhost. The overlay only shows subtitles while the translation is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If OBS runs on another computer, use this Mac's network address instead of localhost. The overlay only shows subtitles while the translation is running."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS başka bir bilgisayardaysa localhost yerine bu Mac'in ağ adresini yazın. Katman yalnızca çeviri çalışırken altyazı gösterir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان OBS يعمل على كمبيوتر آخر فاستخدم عنوان هذا الماك في الشبكة بدلاً من localhost. الطبقة تعرض الترجمة فقط أثناء تشغيل الترجمة."
          }
        }
      }
    },
    "If OBS runs on another computer, use the network address of this PC instead of localhost. The overlay only shows subtitles while the translation is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If OBS runs on another computer, use the network address of this PC instead of localhost. The overlay only shows subtitles while the translation is running."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS başka bir bilgisayardaysa localhost yerine bu bilgisayarın ağ adresini yazın. Katman yalnızca çeviri çalışırken altyazı gösterir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان OBS يعمل على كمبيوتر آخر فاستخدم عنوان هذا الكمبيوتر في الشبكة بدلاً من localhost. الطبقة تعرض الترجمة فقط أثناء تشغيل الترجمة."
          }
        }
      }
    },
    "Allow GameTranslator through Windows Firewall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow GameTranslator through Windows Firewall"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator'a Windows Güvenlik Duvarı'nda izin ver"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـGameTranslator في جدار حماية ويندوز"
          }
        }
      }
    },
    "Windows Firewall now allows GameTranslator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows Firewall now allows GameTranslator."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows Güvenlik Duvarı artık GameTranslator'a izin veriyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جدار حماية ويندوز يسمح الآن لـGameTranslator."
          }
        }
      }
    },
    "Windows Firewall may be blocking the connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows Firewall may be blocking the connection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı Windows Güvenlik Duvarı engelliyor olabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما يمنع جدار حماية ويندوز الاتصال."
          }
        }
      }
    },
    "Waiting for Windows…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Windows…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows bekleniyor…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار ويندوز…"
          }
        }
      }
    },
    "The firewall rule was not added. Try again and choose Yes when Windows asks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The firewall rule was not added. Try again and choose Yes when Windows asks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik duvarı kuralı eklenmedi. Yeniden deneyin ve Windows sorduğunda Evet'i seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُضف قاعدة الجدار. حاول مرة أخرى واختر «نعم» عندما يسأل ويندوز."
          }
        }
      }
    },
    "Open Pair Device again on the PS5 and enter the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح «ربط جهاز» من جديد في الـPS5 وأدخل الرمز الجديد."
          }
        }
      }
    },
    "GameTranslator needs incoming connections from the PS5 and the TV. Windows asks for permission once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator needs incoming connections from the PS5 and the TV. Windows asks for permission once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator'ın PS5'ten ve TV'den gelen bağlantıları alabilmesi gerekiyor. Windows bir kez izin ister."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator يحتاج استقبال الاتصالات من الـPS5 والتلفزيون. ويندوز يطلب الإذن مرة واحدة."
          }
        }
      }
    },
    "Allow GameTranslator, then open Pair Device again on the PS5 and enter the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow GameTranslator, then open Pair Device again on the PS5 and enter the new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator'a izin verin, sonra PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـGameTranslator، ثم افتح «ربط جهاز» من جديد في الـPS5 وأدخل الرمز الجديد."
          }
        }
      }
    },
    "A compatible TV (LG, Samsung, or Android TV) with the GameTranslator TV app": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator TV uygulaması kurulu bir TV (LG, Samsung veya Android TV)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفزيون متوافق (LG أو سامسونج أو Android TV) عليه تطبيق GameTranslator"
          }
        }
      }
    },
    "4. Restart the TV: hold the power button on the remote for about 2 seconds until the TV turns off, then turn it on again. This screen continues by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Restart the TV: hold the power button on the remote for about 2 seconds until the TV turns off, then turn it on again. This screen continues by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. TV'yi yeniden başlatın: kumandanın güç tuşunu TV kapanana kadar yaklaşık 2 saniye basılı tutun, sonra yeniden açın. Bu ekran kendiliğinden devam eder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4. أعد تشغيل التلفزيون: اضغط زر التشغيل في الريموت نحو ثانيتين حتى ينطفئ، ثم شغّله. تكمل هذه الشاشة تلقائياً."
          }
        }
      }
    },
    "Enter account ID manually": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter account ID manually"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap kimliğini elle gir"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل معرّف الحساب يدوياً"
          }
        }
      }
    },
    "If Sony's sign-in page does not open (some internet providers block it), enter the second account's PSN account ID in base64 (12 characters, e.g. AbCdEfGhIjk=).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Sony's sign-in page does not open (some internet providers block it), enter the second account's PSN account ID in base64 (12 characters, e.g. AbCdEfGhIjk=)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sayfası açılmıyorsa (bazı internet sağlayıcıları engelliyor), ikinci hesabın PSN hesap kimliğini base64 olarak yazın (12 karakter, ör. AbCdEfGhIjk=)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تفتح صفحة دخول Sony (بعض مزودي الإنترنت يحجبونها) فأدخل معرّف حساب PSN للحساب الثاني بصيغة base64 (12 حرفاً، مثال: AbCdEfGhIjk=)."
          }
        }
      }
    },
    "If the TV keeps switching to HDMI 1 or another source while the GameTranslator TV app is open, turn off Anynet+ (HDMI-CEC) and Auto Source Switching on the TV: Settings › All Settings › Connection › External Device Manager.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the TV keeps switching to HDMI 1 or another source while the GameTranslator TV app is open, turn off Anynet+ (HDMI-CEC) and Auto Source Switching on the TV: Settings › All Settings › Connection › External Device Manager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator TV uygulaması açıkken TV sürekli HDMI 1'e ya da başka bir kaynağa geçiyorsa TV'de Ayarlar › Tüm Ayarlar › Bağlantı › Harici Cihaz Yöneticisi altında Anynet+ (HDMI-CEC) ve Otomatik Kaynak Değiştirme'yi kapatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا ظل التلفزيون ينتقل إلى HDMI 1 أو مصدر آخر وتطبيق GameTranslator مفتوح فأوقف Anynet+ (HDMI-CEC) والتبديل التلقائي للمصدر في التلفزيون: الإعدادات › كل الإعدادات › الاتصال › مدير الأجهزة الخارجية."
          }
        }
      }
    },
    "PS5 paired: %@ (%@). Press Continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 paired: %@ (%@). Press Continue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 eşleşti: %@ (%@). Devam'a basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إقران الـPS5: %@ (%@). اضغط «متابعة»."
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ"
          }
        }
      }
    },
    "This is not a valid account ID. It is 12 characters in base64, e.g. AbCdEfGhIjk=.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid account ID. It is 12 characters in base64, e.g. AbCdEfGhIjk=."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir hesap kimliği değil. Kimlik base64 biçiminde 12 karakterdir, ör. AbCdEfGhIjk=."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس معرّف حساب صحيحاً. هو 12 حرفاً بصيغة base64، مثال: AbCdEfGhIjk=."
          }
        }
      }
    },
    "To restart a Samsung TV fully, hold the power button on the remote for about 2 seconds until it turns off; a short press only puts it on standby.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To restart a Samsung TV fully, hold the power button on the remote for about 2 seconds until it turns off; a short press only puts it on standby."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung TV'yi tam yeniden başlatmak için kumandanın güç tuşunu TV kapanana kadar yaklaşık 2 saniye basılı tutun; kısa basınca TV yalnız bekleme moduna geçer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإعادة تشغيل تلفزيون سامسونج كاملاً اضغط زر التشغيل في الريموت نحو ثانيتين حتى ينطفئ؛ الضغطة القصيرة تضعه في الاستعداد فقط."
          }
        }
      }
    },
    "Area 1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area 1"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge 1"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنطقة 1"
          }
        }
      }
    },
    "Area 2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area 2"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge 2"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنطقة 2"
          }
        }
      }
    },
    "Area 3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area 3"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge 3"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنطقة 3"
          }
        }
      }
    },
    "Keep previous lines above in fast dialogue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep previous lines above in fast dialogue"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı konuşmada önceki satırları üstte göster"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الجمل السابقة في الأعلى في الحوار السريع"
          }
        }
      }
    },
    "When off, each new line replaces the previous one. Needs TV app 0.9.16 or later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, each new line replaces the previous one. Needs TV app 0.9.16 or later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken her yeni satır öncekinin yerine geçer. TV uygulaması 0.9.16 ve sonrası gerekir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف كل جملة جديدة تحل محل السابقة. يحتاج تطبيق التلفزيون 0.9.16 أو أحدث."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متقدم"
          }
        }
      }
    },
    "These waits only delay lines that were read badly; most lines are shown without waiting. A shorter wait shows those lines sooner but lets more wrong translations through.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These waits only delay lines that were read badly; most lines are shown without waiting. A shorter wait shows those lines sooner but lets more wrong translations through."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bekleme süreleri yalnız kötü okunan satırları geciktirir; satırların çoğu hiç beklemeden gösterilir. Kısa bekleme o satırları daha erken gösterir ama daha çok yanlış çeviriye yol açar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهل تؤخر فقط الجمل التي قُرئت بشكل سيئ؛ أغلب الجمل تُعرض بلا انتظار. المهلة الأقصر تعرض تلك الجمل أسرع لكنها تمرّر ترجمات خاطئة أكثر."
          }
        }
      }
    },
    "Wait for a misread line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for a misread line"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk okunan satır için bekleme"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظار الجملة المقروءة خطأ"
          }
        }
      }
    },
    "When a line is read with words that are not in the dictionary, a better reading is awaited for at most this long. Measured in GTA V, translations from misread lines compared with 0 s: 0.2 s → 77%, 0.4 s → 49%, 0.6 s → 41%, 0.8 s (recommended) → 34%, 1.0 s → 31%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a line is read with words that are not in the dictionary, a better reading is awaited for at most this long. Measured in GTA V, translations from misread lines compared with 0 s: 0.2 s → 77%, 0.4 s → 49%, 0.6 s → 41%, 0.8 s (recommended) → 34%, 1.0 s → 31%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır sözlükte olmayan sözcüklerle okunursa daha iyi bir okuma için en çok bu kadar beklenir. GTA V'te ölçülen, bozuk okumadan çıkan çeviri sayısı (0 sn'ye göre): 0,2 sn → %77, 0,4 sn → %49, 0,6 sn → %41, 0,8 sn (önerilen) → %34, 1,0 sn → %31."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تُقرأ جملة بكلمات ليست في القاموس يُنتظر قراءة أفضل لهذه المدة كحد أقصى. قياساً في GTA V، نسبة الترجمات الناتجة عن جمل مقروءة خطأ مقارنة بـ0 ث: 0.2 ث ← 77%، 0.4 ث ← 49%، 0.6 ث ← 41%، 0.8 ث (مستحسن) ← 34%، 1.0 ث ← 31%."
          }
        }
      }
    },
    "Wait for a half-read line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for a half-read line"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarım okunan satır için bekleme"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظار الجملة المقروءة ناقصة"
          }
        }
      }
    },
    "When a line looks cut off (no sentence ending, such as a mission text with a colored word), the full line is awaited for at most this long. Its effect is small: at 0 s a few more lines arrive cut off. Recommended: 0.3 s.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a line looks cut off (no sentence ending, such as a mission text with a colored word), the full line is awaited for at most this long. Its effect is small: at 0 s a few more lines arrive cut off. Recommended: 0.3 s."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır yarım görünürse (cümle sonu işareti yok; ör. renkli sözcüklü görev yazısı) tamamı için en çok bu kadar beklenir. Etkisi küçüktür: 0 sn'de birkaç satır daha yarım gelir. Önerilen: 0,3 sn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تبدو الجملة مقطوعة (بلا نهاية جملة، مثل نص مهمة فيه كلمة ملوّنة) تُنتظر الجملة كاملة لهذه المدة كحد أقصى. تأثيره صغير: عند 0 ث تصل بضع جمل إضافية مقطوعة. المستحسن: 0.3 ث."
          }
        }
      }
    },
    "Restore defaults": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore defaults"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılanlara dön"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة الافتراضي"
          }
        }
      }
    },
    "sec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "s"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sn"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ث"
          }
        }
      }
    },
    "Check for updates…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri denetle…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من التحديثات…"
          }
        }
      }
    },
    "Draw the area to translate, for example a quest panel. While you play, press its key (Num 1, 2 or 3, or Ctrl+Shift+1, 2 or 3) to read and translate it once. Choose where the result shows. It works even when GameTranslator is in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the area to translate, for example a quest panel. While you play, press its key (Num 1, 2 or 3, or Ctrl+Shift+1, 2 or 3) to read and translate it once. Choose where the result shows. It works even when GameTranslator is in the background."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrilecek alanı çizin (ör. görev paneli). Oynarken kendi tuşuna (Num 1, 2 ya da 3; ya da Ctrl+Shift+1, 2 ya da 3) basınca bu alan bir kez okunup çevrilir. Sonucun nerede görüneceğini seçin. GameTranslator arka plandayken de çalışır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم المنطقة المراد ترجمتها، مثل لوحة المهام. أثناء اللعب اضغط مفتاحها (Num 1 أو 2 أو 3، أو Ctrl+Shift+1 أو 2 أو 3) لتُقرأ وتُترجم مرة واحدة. اختر أين تظهر النتيجة. يعمل حتى وGameTranslator في الخلفية."
          }
        }
      }
    },
    "Free area (Num 5 or Ctrl+Shift+5)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free area (Num 5 or Ctrl+Shift+5)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbest alan (Num 5 ya da Ctrl+Shift+5)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منطقة حرة (Num 5 أو Ctrl+Shift+5)"
          }
        }
      }
    },
    "Num 0 or Ctrl+Shift+0 pauses or resumes the live subtitle translation, which helps when you translate areas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Num 0 or Ctrl+Shift+0 pauses or resumes the live subtitle translation, which helps when you translate areas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Num 0 ya da Ctrl+Shift+0, canlı altyazı çevirisini duraklatır ya da devam ettirir; alan çevirirken işe yarar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Num 0 أو Ctrl+Shift+0 يوقف ترجمة الحوار المباشرة مؤقتاً أو يكملها، وهذا مفيد عند ترجمة المناطق."
          }
        }
      }
    },
    "Press Num 5 or Ctrl+Shift+5 while playing: the picture freezes on the PC, drag over any part of it to translate that part once. Esc closes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Num 5 or Ctrl+Shift+5 while playing: the picture freezes on the PC, drag over any part of it to translate that part once. Esc closes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken Num 5'e ya da Ctrl+Shift+5'e basın: görüntü bilgisayarda donar, çevirmek istediğiniz yeri fareyle seçin, o kısım bir kez çevrilir. Esc kapatır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Num 5 أو Ctrl+Shift+5 أثناء اللعب: تتجمد الصورة على الكمبيوتر، اسحب فوق أي جزء منها لترجمته مرة واحدة. Esc للإغلاق."
          }
        }
      }
    },
    "Refresh picture (Num 8 or Ctrl+Shift+8)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh picture (Num 8 or Ctrl+Shift+8)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüyü yenile (Num 8 ya da Ctrl+Shift+8)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث الصورة (Num 8 أو Ctrl+Shift+8)"
          }
        }
      }
    },
    "The shortcuts work only while translating, so the number keys stay free in other apps. Keep Num Lock on for the Num keys. No numeric keypad? Hold Ctrl+Shift and press the number keys above the letters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcuts work only while translating, so the number keys stay free in other apps. Keep Num Lock on for the Num keys. No numeric keypad? Hold Ctrl+Shift and press the number keys above the letters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar yalnız çeviri açıkken çalışır; böylece sayı tuşları diğer uygulamalarda serbest kalır. Num tuşları için Num Lock açık olmalı. Sayı tuş takımı yoksa Ctrl+Shift'i basılı tutup harflerin üstündeki sayı tuşlarına basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصارات تعمل فقط أثناء الترجمة، فتبقى مفاتيح الأرقام حرة في البرامج الأخرى. أبقِ Num Lock مفعّلاً لمفاتيح Num. لا توجد لوحة أرقام؟ اضغط Ctrl+Shift مع مفاتيح الأرقام فوق الحروف."
          }
        }
      }
    },
    "The PS5 didn't accept this pairing. Pair the PS5 again with the second account in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 didn't accept this pairing. Pair the PS5 again with the second account in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bu kaydı kabul etmedi. Ayarlar'dan PS5'i ikinci hesapla yeniden eşleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل الـPS5 هذا الإقران. اقرن الـPS5 من جديد بالحساب الثاني من الإعدادات."
          }
        }
      }
    },
    "This Samsung TV is too old for the GameTranslator TV app (2017 models and later are supported).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Samsung TV is too old for the GameTranslator TV app (2017 models and later are supported)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Samsung TV, GameTranslator TV uygulaması için çok eski (2017 ve sonraki modeller destekleniyor)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفزيون سامسونج هذا قديم على تطبيق GameTranslator (المدعوم: موديلات 2017 وما بعدها)."
          }
        }
      }
    },
    "Translate the screen (Num 9 or Ctrl+Shift+9)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the screen (Num 9 or Ctrl+Shift+9)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı çevir (Num 9 ya da Ctrl+Shift+9)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجم الشاشة (Num 9 أو Ctrl+Shift+9)"
          }
        }
      }
    },
    "Press Num 9 or Ctrl+Shift+9 while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Num 9 or Ctrl+Shift+9 while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken Num 9'a ya da Ctrl+Shift+9'a basın: ekrandaki bütün yazılar bir kez çevrilir ve TV'de her biri kendi yerinde gösterilir. Çevirileri kaldırmak için yeniden basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Num 9 أو Ctrl+Shift+9 أثناء اللعب: يُترجم كل نص على الشاشة مرة واحدة ويظهر على التلفزيون في مكانه. اضغط ثانية لإزالة الترجمات."
          }
        }
      }
    },
    "Couldn't translate the screen: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't translate the screen: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran çevrilemedi: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت ترجمة الشاشة: %@"
          }
        }
      }
    },
    "%@ has reached its per-minute limit. Try again in a minute.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has reached its per-minute limit. Try again in a minute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dakikalık istek sınırına ulaştı. Bir dakika sonra yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل %@ إلى حدّه في الدقيقة. حاول بعد دقيقة."
          }
        }
      }
    },
    "The free translation isn't downloaded yet.": {
      "localizations": {
