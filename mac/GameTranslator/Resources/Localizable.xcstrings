    "Pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşle"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إقران"
          }
        }
      }
    },
    "Make sure the PS5 is on (not in rest mode) and on the same Wi-Fi, and that GameTranslator is allowed in Settings › Privacy & Security › Local Network. You can also type the PS5's IP address (PS5: Settings › Network › Connection Status).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the PS5 is on (not in rest mode) and on the same Wi-Fi, and that GameTranslator is allowed in Settings › Privacy & Security › Local Network. You can also type the PS5's IP address (PS5: Settings › Network › Connection Status)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in açık (dinlenme modunda değil) ve aynı Wi-Fi'da olduğundan, GameTranslator'a Ayarlar › Gizlilik ve Güvenlik › Yerel Ağ'dan izin verildiğinden emin ol. PS5'in IP adresini de yazabilirsin (PS5: Ayarlar › Ağ › Bağlantı Durumu)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أن الـPS5 مشغّل (وليس في وضع الراحة) وعلى نفس شبكة Wi-Fi، وأن GameTranslator مسموح له من الإعدادات › الخصوصية والأمان › الشبكة المحلية. يمكنك أيضاً كتابة عنوان IP للـPS5 (في الـPS5: الإعدادات › الشبكة › حالة الاتصال)."
          }
        }
      }
    },
