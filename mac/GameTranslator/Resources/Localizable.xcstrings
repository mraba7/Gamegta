    },
    "Num 0 pauses or resumes the live subtitle translation, which helps when you translate areas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Num 0 pauses or resumes the live subtitle translation, which helps when you translate areas."
