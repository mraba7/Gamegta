{
  "sourceLanguage": "en",
  "strings": {
    "Find the subtitles automatically": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the subtitles automatically"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazıyı kendiliğinden bul"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على الترجمة تلقائياً"
          }
        }
      }
    },
    "One-Time Setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Time Setup"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek Seferlik Kurulum"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد لمرة واحدة"
          }
        }
      }
    },
    "The app finds where the game shows its subtitles by itself and ignores menus, hints and on-screen indicators. Turn this off to draw the area yourself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app finds where the game shows its subtitles by itself and ignores menus, hints and on-screen indicators. Turn this off to draw the area yourself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama oyunun altyazıyı gösterdiği yeri kendisi bulur; menüleri, ipuçlarını ve ekrandaki göstergeleri yok sayar. Alanı kendin çizmek için bunu kapat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البرنامج يجد مكان ترجمة اللعبة بنفسه ويتجاهل القوائم والتلميحات ومؤشرات الشاشة. أوقف هذا الخيار لترسم المنطقة بنفسك."
          }
        }
      }
    },
    "This pairing is only required once. When you click 'Start Translation' in GameTranslator, the stream connects automatically; clicking 'Stop Translation' disconnects automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing is only required once. When you click 'Start Translation' in GameTranslator, the stream connects automatically; clicking 'Stop Translation' disconnects automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eşleştirme yalnızca ilk kurulumda bir kez yapılır. GameTranslator'da 'Çeviriyi Başlat' dediğinizde yayın otomatik bağlanır, 'Çeviriyi Durdur' dediğinizde otomatik kapatılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإقران مطلوب مرة واحدة فقط. عند الضغط على «ابدأ الترجمة» يتصل البث تلقائياً، وعند الضغط على «أوقف الترجمة» ينقطع تلقائياً."
          }
        }
      }
    },
    "%@ was damaged while downloading. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was damaged while downloading. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ indirilirken bozuldu. Yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلف %@ أثناء التنزيل. حاول مرة أخرى."
          }
        }
      }
    },
    "1. Create a free account at webostv.developer.lge.com.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Create a free account at webostv.developer.lge.com."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. webostv.developer.lge.com adresinde ücretsiz hesap açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. أنشئ حساباً مجانياً في webostv.developer.lge.com."
          }
        }
      }
    },
    "1. On the TV, open Apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Apps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Uygulamalar ekranını açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. في التلفزيون افتح التطبيقات (Apps)."
          }
        }
      }
    },
    "1. On the TV, open Settings › Device Preferences › About (Google TV: Settings › System › About).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Settings › Device Preferences › About (Google TV: Settings › System › About)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Ayarlar › Cihaz Tercihleri › Hakkında'ya girin (Google TV'de Ayarlar › Sistem › Hakkında)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. في التلفزيون افتح الإعدادات › تفضيلات الجهاز › حول (في Google TV: الإعدادات › النظام › حول)."
          }
        }
      }
    },
    "2. On the TV, install Developer Mode from the LG Content Store and sign in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. On the TV, install Developer Mode from the LG Content Store and sign in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. TV'de LG Content Store'dan Developer Mode uygulamasını kurup giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. في التلفزيون ثبّت Developer Mode من متجر LG وسجّل الدخول."
          }
        }
      }
    },
    "2. Press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Kumandada 1 2 3 4 5 tuşlarına basın (ya da ekran klavyesiyle 12345 yazın). Geliştirici modu penceresi açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. اضغط 1 2 3 4 5 بالريموت (أو اكتب 12345 بلوحة الأرقام على الشاشة). تفتح نافذة وضع المطوّر."
          }
        }
      }
    },
    "2. Press OK on Build 7 times until it says you are a developer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Press OK on Build 7 times until it says you are a developer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Yapı numarasının üstünde Tamam'a, geliştirici olduğunuz yazana kadar 7 kez basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. اضغط OK على رقم الإصدار (Build) 7 مرات حتى يظهر أنك مطوّر."
          }
        }
      }
    },
    "3. Go back to Device Preferences (Google TV: System) › Developer options and turn on USB debugging. Turn on Network debugging too if you see it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Go back to Device Preferences (Google TV: System) › Developer options and turn on USB debugging. Turn on Network debugging too if you see it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cihaz Tercihleri (Google TV'de Sistem) › Geliştirici seçenekleri'ne dönüp USB hata ayıklama'yı açın. Ağ hata ayıklama varsa onu da açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. ارجع إلى تفضيلات الجهاز (في Google TV: النظام) › خيارات المطوّر وفعّل تصحيح أخطاء USB. فعّل تصحيح أخطاء الشبكة أيضاً إن ظهر."
          }
        }
      }
    },
    "3. Turn Developer mode On, type this computer's address as Host PC IP: %@ and press OK.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Turn Developer mode On, type this computer's address as Host PC IP: %@ and press OK."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer mode'u On yapın, Host PC IP olarak bu bilgisayarın adresini yazın: %@ ve OK'e basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. فعّل Developer mode، واكتب عنوان هذا الكمبيوتر في خانة Host PC IP: %@ ثم اضغط OK."
          }
        }
      }
    },
    "3. Turn on Dev Mode Status. The TV restarts and this screen continues by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Turn on Dev Mode Status. The TV restarts and this screen continues by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Dev Mode Status'u açın. TV yeniden başlar, bu ekran kendiliğinden devam eder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. فعّل Dev Mode Status. يعيد التلفزيون التشغيل وتكمل هذه الشاشة تلقائياً."
          }
        }
      }
    },
    "4. Restart the TV. This screen continues by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Restart the TV. This screen continues by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. TV'yi yeniden başlatın. Bu ekran kendiliğinden devam eder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4. أعد تشغيل التلفزيون. تكمل هذه الشاشة تلقائياً."
          }
        }
      }
    },
    "8-digit code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8-digit code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 haneli kod"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز من 8 أرقام"
          }
        }
      }
    },
    "A PS5 on the same Wi-Fi network as this Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5 on the same Wi-Fi network as this Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac ile aynı Wi-Fi ağında bir PS5"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 على نفس شبكة Wi-Fi مع هذا الماك"
          }
        }
      }
    },
    "A PS5 on the same network as this computer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5 on the same network as this computer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarla aynı ağda bir PS5"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 على نفس شبكة هذا الكمبيوتر"
          }
        }
      }
    },
    "A free second PlayStation Network account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free second PlayStation Network account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ikinci bir PlayStation Network hesabı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب PlayStation Network ثانٍ مجاني"
          }
        }
      }
    },
    "A new version of GameTranslator is available: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of GameTranslator is available: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator'ın yeni sürümü çıktı: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد إصدار جديد من GameTranslator: %@"
          }
        }
      }
    },
    "A second PSN account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second PSN account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci bir PSN hesabı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب PSN ثانٍ"
          }
        }
      }
    },
    "About GameTranslator": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About GameTranslator"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator Hakkında"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حول GameTranslator"
          }
        }
      }
    },
    "Above the English subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the English subtitle"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilizce altyazının üstünde"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فوق الترجمة الإنجليزية"
          }
        }
      }
    },
    "Accept the request on the TV…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the request on the TV…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki isteği onaylayın…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقبل الطلب على التلفزيون…"
          }
        }
      }
    },
    "Adjust the frame so it covers where the game shows its subtitles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the frame so it covers where the game shows its subtitles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerçeveyi, oyunun altyazıyı gösterdiği alanı kaplayacak şekilde ayarlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط الإطار ليغطي المكان الذي تعرض فيه اللعبة ترجمتها."
          }
        }
      }
    },
    "An LG TV with the GameTranslator TV app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An LG TV with the GameTranslator TV app"
          }
        },
        "tr": {
