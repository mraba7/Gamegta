          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الترجمة هنا أثناء اللعب."
          }
        }
      }
    },
    "Switch back to your own user. You only do this once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch back to your own user. You only do this once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi kullanıcınıza geri dönün. Bunu yalnızca bir kez yaparsınız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى مستخدمك الأصلي. تفعل هذا مرة واحدة فقط."
          }
        }
      }
    },
    "TV": {
