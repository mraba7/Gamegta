    "Could not connect to the TV. Accept the request on the TV screen and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to the TV. Accept the request on the TV screen and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye bağlanılamadı. TV ekranındaki isteği onaylayıp yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بالتلفزيون. اقبل الطلب على شاشة التلفزيون وحاول مرة أخرى."
          }
        }
      }
    },
    "To install the TV app for the first time, use GameTranslator on a computer once. After that this phone is enough.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To install the TV app for the first time, use GameTranslator on a computer once. After that this phone is enough."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV uygulamasını ilk kez kurmak için bir kez bilgisayardaki GameTranslator'ı kullanın. Sonrasında bu telefon yeterli."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتثبيت تطبيق التلفزيون أول مرة استخدم GameTranslator على كمبيوتر مرة واحدة. بعدها يكفي هذا الجوال."
          }
        }
      }
    },
    "Keep GameTranslator open on the screen while you play. iOS stops the connection when the app goes to the background; the screen stays on while translating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep GameTranslator open on the screen while you play. iOS stops the connection when the app goes to the background; the screen stays on while translating."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken GameTranslator ekranda açık kalsın. iOS, arka plana geçen uygulamanın bağlantısını keser; çeviri sürerken ekran kararmaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ GameTranslator مفتوحاً على الشاشة أثناء اللعب. iOS يقطع الاتصال عندما يذهب التطبيق إلى الخلفية؛ الشاشة تبقى مضاءة أثناء الترجمة."
          }
        }
      }
    },
    "The English–Turkish language pack is not downloaded yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The English–Turkish language pack is not downloaded yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilizce–Türkçe dil paketi henüz indirilmedi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزمة اللغة الإنجليزية–التركية لم تُنزَّل بعد."
          }
        }
      }
    },
    "Use the ready Turkish translations of game packs": {
      "localizations": {
