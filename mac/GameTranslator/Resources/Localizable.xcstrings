        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل %@ هذا المفتاح. انسخه من جديد من صفحة حسابك."
          }
        }
      }
    },
    "Your %@ account has no credit left or has reached its limit.": {
