    "Open Settings › Time & language › Language & region, add English and select its optical character recognition feature.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings › Time & language › Language & region, add English and select its optical character recognition feature."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar › Saat ve dil › Dil ve bölge'yi açın, İngilizce'yi ekleyin ve optik karakter tanıma özelliğini seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات › الوقت واللغة › اللغة والمنطقة، أضف الإنجليزية واختر ميزة التعرّف الضوئي على الحروف لها."
          }
        }
      }
    },
    "Open System Settings › General › Language & Region › Translation Languages and download both languages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings › General › Language & Region › Translation Languages and download both languages."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları › Genel › Dil ve Bölge › Çeviri Dilleri'ni açıp iki dili de indirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات النظام › عام › اللغة والمنطقة › لغات الترجمة ونزّل اللغتين."
          }
        }
      }
    },
