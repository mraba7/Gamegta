    "Sign in to PlayStation Network with the second account you just created. Your password goes directly to Sony; GameTranslator only keeps the account ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to PlayStation Network with the second account you just created. Your password goes directly to Sony; GameTranslator only keeps the account ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce açtığınız ikinci hesapla PlayStation Network'e giriş yapın. Şifreniz doğrudan Sony'ye gider; GameTranslator yalnızca hesap kimliğini saklar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول في PlayStation Network بالحساب الثاني الذي أنشأته. كلمة المرور تذهب مباشرة إلى Sony؛ GameTranslator يحتفظ بمعرّف الحساب فقط."
          }
        }
      }
    },
    "Sign in with the second account": {
      "localizations": {
        "en": {
