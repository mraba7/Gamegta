        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف ما حُفظ من اتصال الـPS5 والحساب والتلفزيون."
          }
        }
      }
    },
    "The second user has a login passcode on the PS5. Turn it off in Settings › Users and Accounts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second user has a login passcode on the PS5. Turn it off in Settings › Users and Accounts."
