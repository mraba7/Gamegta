          }
        }
      }
    },
    "Press ⌥⌘T while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌥⌘T while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken ⌥⌘T'ye basın: ekrandaki bütün yazılar bir kez çevrilir ve TV'de her biri kendi yerinde gösterilir. Çevirileri kaldırmak için yeniden basın."
          }
        },
        "ar": {
          "stringUnit": {
