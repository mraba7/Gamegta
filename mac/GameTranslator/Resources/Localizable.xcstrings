    "Press Num 5 while playing: the picture freezes on the PC, drag over any part of it to translate that part once. Esc closes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Num 5 while playing: the picture freezes on the PC, drag over any part of it to translate that part once. Esc closes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken Num 5'e basın: görüntü bilgisayarda donar, çevirmek istediğiniz yeri fareyle seçin, o kısım bir kez çevrilir. Esc kapatır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Num 5 أثناء اللعب: تتجمد الصورة على الكمبيوتر، اسحب فوق أي جزء منها لترجمته مرة واحدة. Esc للإغلاق."
          }
        }
      }
