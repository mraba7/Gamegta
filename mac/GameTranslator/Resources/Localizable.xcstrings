    },
    "macOS can't read the text on the screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS can't read the text on the screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ekrandaki yazıyı okuyamıyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS لا يستطيع قراءة النص على الشاشة."
          }
        }
      }
    },
    "The disk is almost full (%.1f GB free). macOS needs free space to read text; free up a few GB and start the translation again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is almost full (%.1f GB free). macOS needs free space to read text; free up a few GB and start the translation again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk neredeyse dolu (%.1f GB boş). macOS'in yazıyı okuyabilmesi için boş yer gerekiyor; birkaç GB yer açıp çeviriyi yeniden başlatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القرص شبه ممتلئ (المتاح %.1f جيجابايت). macOS يحتاج مساحة لقراءة النص؛ أفرغ بضعة جيجابايت وابدأ الترجمة من جديد."
          }
        }
      }
    },
    "Restart the Mac and start the translation again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the Mac and start the translation again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'i yeniden başlatıp çeviriyi yeniden başlatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل الماك وابدأ الترجمة من جديد."
          }
        }
      }
    },
    "OBS overlay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS overlay"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS katmanı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طبقة OBS"
          }
        }
      }
    },
    "Streaming with a capture card? In OBS add a Browser source with this address (width 1920, height 1080). The Turkish subtitles appear over the game on your screen and on the stream.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming with a capture card? In OBS add a Browser source with this address (width 1920, height 1080). The Turkish subtitles appear over the game on your screen and on the stream."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture card ile yayın mı yapıyorsunuz? OBS'de bu adresle bir Tarayıcı kaynağı ekleyin (genişlik 1920, yükseklik 1080). Türkçe altyazı hem sizin ekranınızda hem yayında oyunun üstünde görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبث بكرت التقاط؟ أضف في OBS مصدر متصفح بهذا العنوان (العرض 1920، الارتفاع 1080). تظهر الترجمة فوق اللعبة على شاشتك وفي البث."
          }
        }
      }
    },
    "Copy": {
      "localizations": {
