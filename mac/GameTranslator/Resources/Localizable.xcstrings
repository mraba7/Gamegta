    "The key did not work. Check it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key did not work. Check it and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar çalışmadı. Kontrol edip yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح لم يعمل. تحقق منه وحاول مرة أخرى."
          }
        }
      }
    },
    "The PS5 did not answer. Make sure it is on (not in rest mode), on the same Wi-Fi as this phone, and that Remote Play is turned on, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 did not answer. Make sure it is on (not in rest mode), on the same Wi-Fi as this phone, and that Remote Play is turned on, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 yanıt vermedi. Açık olduğundan (dinlenme modunda değil), bu telefonla aynı Wi-Fi ağında olduğundan ve Uzaktan Oynatma'nın açık olduğundan emin olup yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرد الـPS5. تأكد أنه مشغّل (وليس في وضع الراحة)، وعلى نفس شبكة Wi-Fi مع هذا الجوال، وأن اللعب عن بُعد مفعّل، ثم حاول مرة أخرى."
          }
        }
      }
    },
    "iOS blocked the connection to the home network. Turn on GameTranslator in Settings › Privacy & Security › Local Network, then enter a new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blocked the connection to the home network. Turn on GameTranslator in Settings › Privacy & Security › Local Network, then enter a new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ev ağına bağlantıyı engelledi. Ayarlar › Gizlilik ve Güvenlik › Yerel Ağ'dan GameTranslator'ı açıp yeni kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع iOS الاتصال بشبكة البيت. فعّل GameTranslator من الإعدادات › الخصوصية والأمان › الشبكة المحلية، ثم أدخل رمزاً جديداً."
          }
        }
      }
