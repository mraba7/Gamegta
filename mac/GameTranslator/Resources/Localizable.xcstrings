    "Windows' own Turkish voice: speaks at once, nothing to download. Sounds more mechanical.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows' own Turkish voice: speaks at once, nothing to download. Sounds more mechanical."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows'un kendi Türkçe sesi: anında konuşur, indirme gerekmez. Daha mekanik duyulur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوت ويندوز التركي: ينطق فوراً ولا يحتاج تنزيلاً. يبدو آلياً أكثر."
          }
        }
      }
    },
    "Natural voices, downloaded once. Each line takes a moment to prepare, so the voice can come a little after the subtitle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Natural voices, downloaded once. Each line takes a moment to prepare, so the voice can come a little after the subtitle."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğal sesler, bir kez indirilir. Her cümlenin hazırlanması biraz sürdüğü için ses altyazıdan biraz sonra gelebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصوات طبيعية تُنزَّل مرة واحدة. كل جملة تحتاج لحظة للتجهيز، فقد يأتي الصوت بعد الترجمة بقليل."
          }
        }
      }
    },
    "Online translation (DeepL)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online translation (DeepL)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi çeviri (DeepL)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة عبر الإنترنت (DeepL)"
          }
        }
      }
    },
    "Optional. With your own free DeepL key, translations read more naturally. Subtitle text is sent to DeepL; when DeepL cannot be reached, the translation model on this computer takes over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. With your own free DeepL key, translations read more naturally. Subtitle text is sent to DeepL; when DeepL cannot be reached, the translation model on this computer takes over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Kendi ücretsiz DeepL anahtarınızla çeviriler daha doğal olur. Altyazı metni DeepL'e gönderilir; DeepL'e ulaşılamazsa bu bilgisayardaki çeviri modeli devreye girer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. بمفتاح DeepL المجاني الخاص بك تصير الترجمة أكثر سلاسة. يُرسل نص الترجمة إلى DeepL؛ وإذا تعذّر الوصول إليه يتولى نموذج الترجمة على هذا الكمبيوتر."
          }
        }
      }
    },
    "Save and test": {
      "localizations": {
