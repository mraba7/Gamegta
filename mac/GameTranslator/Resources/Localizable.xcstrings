    "GameTranslator is free and open source (AGPL-3.0). Remote Play uses chiaki-ng (AGPL-3.0).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator is free and open source (AGPL-3.0). Remote Play uses chiaki-ng (AGPL-3.0)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator ücretsiz ve açık kaynaklıdır (AGPL-3.0). Remote Play için chiaki-ng (AGPL-3.0) kullanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator مجاني ومفتوح المصدر (AGPL-3.0). Remote Play يستخدم chiaki-ng (AGPL-3.0)."
