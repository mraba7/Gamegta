        }
      }
    },
    "Translate the screen (Num 9)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the screen (Num 9)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı çevir (Num 9)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجم الشاشة (Num 9)"
          }
        }
      }
    },
    "Press Num 9 while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Num 9 while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken Num 9'a basın: ekrandaki bütün yazılar bir kez çevrilir ve TV'de her biri kendi yerinde gösterilir. Çevirileri kaldırmak için yeniden basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Num 9 أثناء اللعب: يُترجم كل نص على الشاشة مرة واحدة ويظهر على التلفزيون في مكانه. اضغط ثانية لإزالة الترجمات."
          }
        }
      }
    },
    "Translate the screen (⌥⌘T)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the screen (⌥⌘T)"
          }
        },
