    "Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olmadan Windows altyazıyı sistem dilinizle okur ve çeviri anlamsızlaşır. Bir kez kurun; Windows izin ister."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدونه يقرأ ويندوز الترجمة بلغة نظامك فتتحول الترجمة إلى كلام غير مفهوم. ثبّته مرة واحدة؛ ويندوز يطلب الإذن."
          }
        }
      }
    },
