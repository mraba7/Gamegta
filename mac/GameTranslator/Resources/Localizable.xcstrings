    },
    "No LG or Samsung TV found. Make sure the TV is on and on the same network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No LG or Samsung TV found. Make sure the TV is on and on the same network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LG ya da Samsung TV bulunamadı. TV'nin açık ve aynı ağda olduğundan emin olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على تلفزيون LG أو سامسونج. تأكد أن التلفزيون مشغّل وعلى نفس الشبكة."
          }
        }
      }
    },
    "No PS5 found. Make sure it is on and on the same network, or enter its IP address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PS5 found. Make sure it is on and on the same network, or enter its IP address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bulunamadı. Açık ve aynı ağda olduğundan emin olun ya da IP adresini girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على PS5. تأكد أنه مشغّل وعلى نفس الشبكة، أو أدخل عنوان IP الخاص به."
          }
        }
      }
    },
    "No account? You can create a free one on the same page. If the browser asks to allow access to devices on your network, allow it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account? You can create a free one on the same page. If the browser asks to allow access to devices on your network, allow it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız yok mu? Aynı sayfadan ücretsiz açabilirsiniz. Tarayıcı ağınızdaki cihazlara erişim izni sorarsa izin verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديك حساب؟ يمكنك إنشاء حساب مجاني من نفس الصفحة. إذا طلب المتصفح السماح بالوصول لأجهزة شبكتك فاسمح له."
          }
        }
      }
    },
    "No text found in this area.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text found in this area."
          }
        },
        "tr": {
