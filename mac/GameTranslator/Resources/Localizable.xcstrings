    "The PS5 asks for this account's login passcode. Enter it in Settings, or turn off this account's login passcode on the PS5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 asks for this account's login passcode. Enter it in Settings, or turn off this account's login passcode on the PS5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bu hesap için giriş şifresi istiyor. Ayarlar'dan şifreyi girin ya da PS5'te bu hesabın giriş şifresini kapatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الـPS5 يطلب رمز دخول هذا الحساب. أدخله في الإعدادات، أو أوقف رمز دخول هذا الحساب في الـPS5."
          }
        }
      }
    },
    "The PS5 didn't accept the login passcode in Settings. Correct it, or turn off this account's login passcode on the PS5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 didn't accept the login passcode in Settings. Correct it, or turn off this account's login passcode on the PS5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, Ayarlar'daki giriş şifresini kabul etmedi. Şifreyi düzeltin ya da PS5'te bu hesabın giriş şifresini kapatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل الـPS5 رمز الدخول المحفوظ في الإعدادات. صحّحه، أو أوقف رمز دخول هذا الحساب في الـPS5."
          }
        }
      }
    },
    "PS5 login passcode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 login passcode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 giriş şifresi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز دخول الـPS5"
          }
        }
      }
    },
    "Only needed if the second account has a login passcode on the PS5. GameTranslator enters it when the PS5 asks. It is kept in the Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only needed if the second account has a login passcode on the PS5. GameTranslator enters it when the PS5 asks. It is kept in the Keychain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız ikinci hesabın PS5'te giriş şifresi varsa gerekir. PS5 isteyince GameTranslator girer. Anahtar Zinciri'nde saklanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب فقط إذا كان للحساب الثاني رمز دخول في الـPS5. GameTranslator يدخله عندما يطلبه الـPS5. يُحفظ في Keychain."
          }
        }
      }
    },
    "Passcode saved.": {
      "localizations": {
