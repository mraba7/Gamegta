          }
        }
      }
    },
    "This is not a valid IP address. Type it like 192.168.1.20, without http:// or a port number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid IP address. Type it like 192.168.1.20, without http:// or a port number."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir IP adresi değil. 192.168.1.20 gibi, http:// ve port numarası olmadan yazın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس عنوان IP صحيحاً. اكتبه هكذا 192.168.1.20، بدون http:// أو رقم منفذ."
          }
        }
      }
    },
    "This address is not valid. Example: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address is not valid. Example: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adres geçerli değil. Örnek: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنوان غير صحيح. مثال: %@"
          }
        }
      }
    },
    "Type the model name as the server shows it. In Ollama, download it first: ollama pull qwen2.5:7b (downloaded models: ollama list). In LM Studio, load the model and start the local server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the model name as the server shows it. In Ollama, download it first: ollama pull qwen2.5:7b (downloaded models: ollama list). In LM Studio, load the model and start the local server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model adını sunucunun gösterdiği gibi yazın. Ollama'da önce indirin: ollama pull qwen2.5:7b (indirilen modeller: ollama list). LM Studio'da modeli yükleyip yerel sunucuyu başlatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب اسم المودل كما يعرضه الخادم. في Ollama نزّله أولاً: ollama pull qwen2.5:7b (المودلات المنزّلة: ollama list). في LM Studio حمّل المودل وشغّل الخادم المحلي."
          }
        }
      }
    },
