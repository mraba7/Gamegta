          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ. حاول مرة أخرى."
          }
        }
      }
    },
    "Couldn't capture the screen: no picture from the PS5 yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't capture the screen: no picture from the PS5 yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yakalanamadı: PS5'ten henüz görüntü gelmedi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التقاط الشاشة: لا توجد صورة من الـPS5 بعد."
          }
        }
      }
    },
    "The sign-in window needs Microsoft's WebView2 component, which is missing on this computer. Install it from the page that just opened, then press Sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window needs Microsoft's WebView2 component, which is missing on this computer. Install it from the page that just opened, then press Sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş penceresi için Microsoft'un WebView2 bileşeni gerekiyor ve bu bilgisayarda yok. Az önce açılan sayfadan kurun, sonra yeniden Giriş yap'a basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نافذة تسجيل الدخول تحتاج مكوّن WebView2 من مايكروسوفت، وهو غير موجود على هذا الكمبيوتر. ثبّته من الصفحة التي فُتحت للتو، ثم اضغط «تسجيل الدخول» من جديد."
          }
        }
      }
    },
    "Translation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة"
          }
        }
      }
    },
    "Translation engine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation engine"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri motoru"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الترجمة"
          }
        }
      }
    },
    "Free (on this Mac)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free (on this Mac)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz (bu Mac'te)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجانية (على هذا الماك)"
          }
        }
      }
    },
    "Free (on this computer)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free (on this computer)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz (bu bilgisayarda)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجانية (على هذا الكمبيوتر)"
          }
        }
      }
    },
    "Free. Apple's translation runs on this Mac; subtitle text never leaves it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free. Apple's translation runs on this Mac; subtitle text never leaves it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz. Apple'ın çevirisi bu Mac'te çalışır; altyazı metni Mac'ten hiç çıkmaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجانية. ترجمة Apple تعمل على هذا الماك؛ نص الترجمة لا يغادره."
          }
        }
      }
    },
    "Free. The translation model built into GameTranslator runs on this computer; subtitle text never leaves it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free. The translation model built into GameTranslator runs on this computer; subtitle text never leaves it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz. GameTranslator'ın kendi çeviri modeli bu bilgisayarda çalışır; altyazı metni bilgisayardan hiç çıkmaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجانية وبدون مفتاح. جودتها أقل من خدمات الذكاء الاصطناعي."
          }
        }
      }
    },
    "Google's AI translates with the game's tone and keeps names as they are. Subtitle text is sent to Google with your own key, and any cost is billed to your Google account. When Gemini cannot be reached, the free translation takes over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google's AI translates with the game's tone and keeps names as they are. Subtitle text is sent to Google with your own key, and any cost is billed to your Google account. When Gemini cannot be reached, the free translation takes over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'ın yapay zekâsı oyunun havasına uygun çevirir, adları olduğu gibi bırakır. Altyazı metni kendi anahtarınızla Google'a gönderilir; ücret çıkarsa Google hesabınıza yansır. Gemini'ye ulaşılamazsa ücretsiz çeviri devreye girer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذكاء Google الاصطناعي يترجم بأسلوب اللعبة. يُرسل نص الترجمة إلى Google بمفتاحك، وأي تكلفة تُحسب على حسابك في Google. إذا تعذّر الوصول إلى Gemini تتولى الترجمة المجانية."
          }
        }
      }
    },
    "OpenAI's AI translates with the game's tone and keeps names as they are. Subtitle text is sent to OpenAI with your own key, and any cost is billed to your OpenAI account. When OpenAI cannot be reached, the free translation takes over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI's AI translates with the game's tone and keeps names as they are. Subtitle text is sent to OpenAI with your own key, and any cost is billed to your OpenAI account. When OpenAI cannot be reached, the free translation takes over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI'ın yapay zekâsı oyunun havasına uygun çevirir, adları olduğu gibi bırakır. Altyazı metni kendi anahtarınızla OpenAI'a gönderilir; ücret çıkarsa OpenAI hesabınıza yansır. OpenAI'a ulaşılamazsa ücretsiz çeviri devreye girer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذكاء OpenAI الاصطناعي يترجم بأسلوب اللعبة. يُرسل نص الترجمة إلى OpenAI بمفتاحك، وأي تكلفة تُحسب على حسابك في OpenAI. إذا تعذّر الوصول إلى OpenAI تتولى الترجمة المجانية."
          }
        }
      }
    },
    "Anthropic's Claude translates with the game's tone and keeps names as they are. Subtitle text is sent to Anthropic with your own key, and any cost is billed to your Anthropic account. When Claude cannot be reached, the free translation takes over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic's Claude translates with the game's tone and keeps names as they are. Subtitle text is sent to Anthropic with your own key, and any cost is billed to your Anthropic account. When Claude cannot be reached, the free translation takes over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic'in Claude'u oyunun havasına uygun çevirir, adları olduğu gibi bırakır. Altyazı metni kendi anahtarınızla Anthropic'e gönderilir; ücret çıkarsa Anthropic hesabınıza yansır. Claude'a ulaşılamazsa ücretsiz çeviri devreye girer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude من Anthropic يترجم بأسلوب اللعبة. يُرسل نص الترجمة إلى Anthropic بمفتاحك، وأي تكلفة تُحسب على حسابك في Anthropic. إذا تعذّر الوصول إلى Claude تتولى الترجمة المجانية."
          }
        }
      }
    },
    "Online engines translate English games only. For other game languages the free translation is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online engines translate English games only. For other game languages the free translation is used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi motorlar yalnız İngilizce oyunları çevirir. Diğer oyun dillerinde ücretsiz çeviri kullanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخدمات عبر الإنترنت تترجم الألعاب الإنجليزية فقط. للغات الألعاب الأخرى تُستخدم الترجمة المجانية."
          }
        }
      }
    },
    "It works.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
