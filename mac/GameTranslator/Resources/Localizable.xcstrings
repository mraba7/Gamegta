    "Tap after you open the game on the PS5. The phone takes the picture, reads the subtitles and translates them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap after you open the game on the PS5. The phone takes the picture, reads the subtitles and translates them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te oyunu açtıktan sonra dokun. Telefon görüntüyü alır, altyazıyı okuyup çevirir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط بعد فتح اللعبة على الـPS5. الجوال يأخذ الصورة ويقرأ الترجمة ويترجمها."
          }
        }
      }
    },
