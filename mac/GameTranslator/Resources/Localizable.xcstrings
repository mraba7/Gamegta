            "state": "translated",
            "value": "يعمل."
          }
        }
      }
    },
    "%@ did not accept this key. Copy it again from your account page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not accept this key. Copy it again from your account page."
