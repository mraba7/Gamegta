    },
    "This month's DeepL limit is used up. Until it renews, the translation model on this computer translates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's DeepL limit is used up. Until it renews, the translation model on this computer translates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın DeepL sınırı doldu. Sınır yenilenene kadar bu bilgisayardaki çeviri modeli çevirir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى حد DeepL لهذا الشهر. حتى يتجدد يترجم نموذج الترجمة على هذا الكمبيوتر."
          }
        }
      }
    },
    "DeepL did not accept this key. Copy it again from your DeepL account page.": {
      "localizations": {
