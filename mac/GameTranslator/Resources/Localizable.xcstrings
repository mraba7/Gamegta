        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun dili"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لغة اللعبة"
          }
        }
      }
    },
    "German": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "German"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Almanca"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألمانية"
          }
        }
      }
    },
    "IP address, e.g. 192.168.1.20": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IP address, e.g. 192.168.1.20"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IP adresi, ör. 192.168.1.20"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان IP، مثال: 192.168.1.20"
          }
        }
      }
    },
    "If Windows asks whether GameTranslator may use the network, allow it for private networks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Windows asks whether GameTranslator may use the network, allow it for private networks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows, GameTranslator'ın ağı kullanmasına izin verip vermeyeceğinizi sorarsa özel ağlar için izin verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا سأل ويندوز هل يُسمح لـGameTranslator باستخدام الشبكة فاسمح له للشبكات الخاصة."
          }
        }
      }
    },
    "If you don't see it, make sure the GameTranslator TV app is open and connect the TV again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't see it, make sure the GameTranslator TV app is open and connect the TV again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görmüyorsanız GameTranslator TV uygulamasının açık olduğundan emin olun ve TV'yi yeniden bağlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم ترها فتأكد أن تطبيق GameTranslator مفتوح على التلفزيون ثم اربط التلفزيون من جديد."
          }
        }
      }
    },
    "In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit yerdeyken altyazıyı TV kumandasının ▲ ve ▼ tuşlarıyla da taşıyabilirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الموضع الثابت يمكنك أيضاً تحريك الترجمة بزرّي ▲ و▼ في ريموت التلفزيون."
          }
        }
      }
    },
    "In the game's audio settings, turn the dialogue (voice) volume down; keep music and effects. If the game can show speaker names in subtitles, turn them on: every character then speaks with its own voice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the game's audio settings, turn the dialogue (voice) volume down; keep music and effects. If the game can show speaker names in subtitles, turn them on: every character then speaks with its own voice."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun ses ayarlarından konuşma (diyalog) sesini kısın; müzik ve efektler kalsın. Oyun altyazıda konuşmacı adını gösterebiliyorsa bunu açın: her karakter kendi sesiyle konuşur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من إعدادات الصوت في اللعبة اخفض صوت الحوار (الأصوات) وأبقِ الموسيقى والمؤثرات. إن كانت اللعبة تعرض أسماء المتكلمين في الترجمة ففعّلها: عندها تتكلم كل شخصية بصوتها."
          }
        }
      }
    },
    "Install on the TV": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install on the TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye kur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت على التلفزيون"
          }
        }
      }
    },
    "Install the GameTranslator TV app on this TV using the guide and open it. It finds this computer by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the GameTranslator TV app on this TV using the guide and open it. It finds this computer by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator TV uygulamasını rehberdeki gibi bu TV'ye kurup açın. Uygulama bu bilgisayarı kendisi bulur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت تطبيق GameTranslator على هذا التلفزيون باتباع الدليل ثم افتحه. يجد هذا الكمبيوتر تلقائياً."
          }
        }
      }
    },
    "Install with a USB stick instead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install with a USB stick instead"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine USB bellekle kur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت بفلاشة USB بدلاً من ذلك"
          }
        }
      }
    },
    "Installing the TV app…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing the TV app…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV uygulaması kuruluyor…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تثبيت تطبيق التلفزيون…"
          }
        }
      }
    },
