    "Menu names differ a little by brand. If the app is already on the TV, you can skip this step.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu names differ a little by brand. If the app is already on the TV, you can skip this step."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü adları markaya göre biraz değişir. Uygulama TV'de zaten kuruluysa bu adımı geçebilirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء القوائم تختلف قليلاً بين الشركات. إن كان التطبيق مثبّتاً على التلفزيون فيمكنك تخطي هذه الخطوة."
          }
        }
      }
    },
    "Narrator and unnamed lines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrator and unnamed lines"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlatıcı ve adı yazmayan satırlar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الراوي والجمل بدون اسم"
          }
        }
