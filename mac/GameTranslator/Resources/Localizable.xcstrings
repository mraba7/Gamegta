    "GameTranslator works with LG (webOS 4+), Samsung (Tizen, 2019+) and Android TV / Google TV. Type the TV's IP address, or choose Android TV: its GameTranslator app finds this phone by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator works with LG (webOS 4+), Samsung (Tizen, 2019+) and Android TV / Google TV. Type the TV's IP address, or choose Android TV: its GameTranslator app finds this phone by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator; LG (webOS 4 ve üstü), Samsung (Tizen, 2019 ve sonrası) ve Android TV / Google TV ile çalışır. TV'nin IP adresini yaz ya da Android TV'yi seç: oradaki GameTranslator uygulaması bu telefonu kendisi bulur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GameTranslator يعمل مع LG (webOS 4 وأحدث) وسامسونج (Tizen، 2019 وأحدث) و Android TV / Google TV. اكتب عنوان IP للتلفزيون، أو اختر Android TV: تطبيق GameTranslator فيه يجد هذا الجوال تلقائياً."
          }
        }
      }
    },
    "The pack is chosen by itself when the game opens. Lines not in the pack are translated with the engine you chose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pack is chosen by itself when the game opens. Lines not in the pack are translated with the engine you chose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun açılınca paket kendiliğinden seçilir. Pakette olmayan satır seçtiğin motorla çevrilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُختار الحزمة تلقائياً عند فتح اللعبة. الجمل غير الموجودة في الحزمة تُترجم بالخدمة التي اخترتها."
          }
        }
      }
    },
