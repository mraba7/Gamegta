    },
    "Your devices, PSN account and translation settings are here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices, PSN account and translation settings are here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazların, PSN hesabın ve çeviri ayarların burada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجهزتك وحساب PSN وإعدادات الترجمة هنا."
          }
        }
      }
    },
    "Apple's free translation needs macOS 26 or later. Game packs, DeepL and AI translation (Settings › Translation) work on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's free translation needs macOS 26 or later. Game packs, DeepL and AI translation (Settings › Translation) work on this Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'ın ücretsiz çevirisi macOS 26 ve sonrasında çalışır. Oyun paketleri, DeepL ve yapay zekâ çevirisi (Ayarlar › Çeviri) bu Mac'te de çalışır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة Apple المجانية تحتاج macOS 26 أو أحدث. حزم الألعاب و DeepL وترجمة الذكاء الاصطناعي (الإعدادات › الترجمة) تعمل على هذا الماك."
          }
        }
      }
    },
    "Apple's free translation needs iOS 26 or later. Game packs, DeepL and AI translation work on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's free translation needs iOS 26 or later. Game packs, DeepL and AI translation work on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'ın ücretsiz çevirisi iOS 26 ve sonrasında çalışır. Oyun paketleri, DeepL ve yapay zekâ çevirisi bu cihazda da çalışır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة Apple المجانية تحتاج iOS 26 أو أحدث. حزم الألعاب و DeepL وترجمة الذكاء الاصطناعي تعمل على هذا الجهاز."
          }
        }
      }
    },
    "If the Mac App Store version cannot install the TV app, install it once with the GitHub (DMG) version of GameTranslator. After that, this version is enough.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the Mac App Store version cannot install the TV app, install it once with the GitHub (DMG) version of GameTranslator. After that, this version is enough."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store sürümü TV uygulamasını kuramıyorsa, TV uygulamasını bir kez GameTranslator'ın GitHub (DMG) sürümüyle kurun. Sonrasında bu sürüm yeter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تستطع نسخة Mac App Store تثبيت تطبيق التلفزيون فثبّته مرة واحدة بنسخة GitHub (DMG) من GameTranslator. بعدها تكفي هذه النسخة."
          }
        }
      }
    },
    "Local model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local model"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مودل محلي"
          }
        }
      }
    },
    "Local model (Ollama, LM Studio)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local model (Ollama, LM Studio)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model (Ollama, LM Studio)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مودل محلي (Ollama, LM Studio)"
          }
        }
      }
    },
    "Free, with no quota. An AI model on this computer (Ollama or LM Studio) translates; subtitle text never leaves it. Speed depends on your computer. When the model cannot be reached, the free translation takes over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free, with no quota. An AI model on this computer (Ollama or LM Studio) translates; subtitle text never leaves it. Speed depends on your computer. When the model cannot be reached, the free translation takes over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ve kotasız. Bu bilgisayardaki bir yapay zekâ modeli (Ollama ya da LM Studio) çevirir; altyazı metni bilgisayardan çıkmaz. Hız bilgisayarınıza bağlıdır. Modele ulaşılamazsa ücretsiz çeviri devreye girer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني وبلا حد. مودل ذكاء اصطناعي على هذا الكمبيوتر (Ollama أو LM Studio) يترجم؛ نص الترجمة لا يغادره. السرعة تعتمد على كمبيوترك. إذا تعذّر الوصول إلى المودل تتولى الترجمة المجانية."
          }
        }
      }
    },
    "The local model server did not accept the API key. Check the key, or remove it if the server does not need one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model server did not accept the API key. Check the key, or remove it if the server does not need one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model sunucusu API anahtarını kabul etmedi. Anahtarı denetleyin; sunucu anahtar istemiyorsa kaldırın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل خادم المودل المحلي مفتاح API. تحقق من المفتاح، أو احذفه إن كان الخادم لا يحتاجه."
          }
        }
      }
    },
    "The local model server is busy. Try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model server is busy. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model sunucusu meşgul. Biraz sonra yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم المودل المحلي مشغول. حاول بعد لحظة."
          }
        }
      }
    },
    "LM Studio does not have the model %@. Download and load it in LM Studio, or check the model name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio does not have the model %@. Download and load it in LM Studio, or check the model name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio'da %@ modeli yok. Modeli LM Studio'da indirip yükleyin ya da model adını denetleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio ليس فيه المودل %@. نزّله وحمّله في LM Studio، أو تحقق من اسم المودل."
          }
        }
      }
    },
    "The model %1$@ is not on the local server. Download it: ollama pull %1$@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model %1$@ is not on the local server. Download it: ollama pull %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ modeli yerel sunucuda yok. Modeli indirin: ollama pull %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المودل %1$@ غير موجود على الخادم المحلي. نزّله: ollama pull %1$@"
          }
        }
      }
    },
    "Ollama is not running: %1$@ could not be reached, or the model did not answer in time. Open Ollama and download the model: ollama pull %2$@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama is not running: %1$@ could not be reached, or the model did not answer in time. Open Ollama and download the model: ollama pull %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama çalışmıyor: %1$@ adresine ulaşılamadı ya da model zamanında yanıt vermedi. Ollama'yı açıp modeli indirin: ollama pull %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama لا يعمل: تعذّر الوصول إلى %1$@، أو لم يرد المودل في الوقت. افتح Ollama ونزّل المودل: ollama pull %2$@"
          }
        }
      }
    },
    "LM Studio is not running: %@ could not be reached, or the model did not answer in time. Open LM Studio, load the model and start the local server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio is not running: %@ could not be reached, or the model did not answer in time. Open LM Studio, load the model and start the local server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio çalışmıyor: %@ adresine ulaşılamadı ya da model zamanında yanıt vermedi. LM Studio'yu açın, modeli yükleyip yerel sunucuyu başlatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio لا يعمل: تعذّر الوصول إلى %@، أو لم يرد المودل في الوقت. افتح LM Studio وحمّل المودل وشغّل الخادم المحلي."
          }
        }
      }
    },
    "The local model server at %@ could not be reached, or the model did not answer in time. Check the address and that the server is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model server at %@ could not be reached, or the model did not answer in time. Check the address and that the server is running."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresindeki yerel model sunucusuna ulaşılamadı ya da model zamanında yanıt vermedi. Adresi ve sunucunun açık olduğunu denetleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خادم المودل المحلي على %@، أو لم يرد المودل في الوقت. تحقق من العنوان ومن أن الخادم يعمل."
          }
        }
      }
    },
    "Ollama or LM Studio, no quota": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama or LM Studio, no quota"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama ya da LM Studio, kotasız"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama أو LM Studio، بلا حد"
          }
        }
      }
    },
    "Server address": {
      "localizations": {
        "en": {
