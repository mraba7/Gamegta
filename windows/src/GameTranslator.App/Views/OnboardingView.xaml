<UserControl x:Class="GameTranslator.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:s="clr-namespace:GameTranslator.App.Views.Steps"
             xmlns:t="clr-namespace:GameTranslator.App.Theme"
             Background="Transparent" Foreground="{DynamicResource textPrimaryBrush}">
    <UserControl.Resources>
        <!-- Seçim kartları: düğme kendi çerçevesini çizmez, kart tüm genişliğe yayılır. -->
        <Style x:Key="PlainCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- ========================================================= -->
        <!-- ÜST BAŞLIK: Logo, Başlık, Adım Rozeti & Kapat Butonu      -->
        <!-- ========================================================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Kurulum" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="&#x202B;دقائق قليلة، ومرة واحدة فقط&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource accentSoftBrush}" CornerRadius="12" Padding="10,3" Margin="0,0,10,0">
                            <TextBlock x:Name="StepBadgeText" Text="&#x202B;الخطوة 1 / 5&#x202C;" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4 Kademeli Adım Çubuğu (Apple Kapsül Butonlar) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Pill1" Grid.Column="0" Click="OnPill1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar1" Height="4" CornerRadius="2" Background="{DynamicResource accentBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText1" Text="&#x202B;أهلاً بك&#x202C;" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource accentTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill2" Grid.Column="2" Click="OnPill2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar2" Height="4" CornerRadius="2" Background="{DynamicResource hairlineBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText2" Text="PS5" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill3" Grid.Column="4" Click="OnPill3" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar3" Height="4" CornerRadius="2" Background="{DynamicResource hairlineBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText3" Text="TV" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill4" Grid.Column="6" Click="OnPill4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar4" Height="4" CornerRadius="2" Background="{DynamicResource hairlineBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText4" Text="Dene" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- ALT ÇUBUK: Geri, Ana Ekrana Geç, Devam Et                 -->
        <!-- ========================================================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Button x:Name="BackButton" Content="&#x202B;← رجوع&#x202C;" Click="OnBack" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="90" MinHeight="34" />
                <Button x:Name="SkipButton" Content="&#x202B;تخطَّ الآن&#x202C;" Click="OnSkipToMain" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" MinHeight="34" Padding="14,0" />
                <Button x:Name="NextButton" Content="&#x202B;متابعة &#x202C;" Click="OnNext" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" MinWidth="110" MinHeight="34">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ADIM İÇERİKLERİ                                           -->
        <!-- ========================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0B0E14" Padding="28,20">
            <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                <!-- ==================== ADIM 1: BAŞLANGIÇ ==================== -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource accentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="&#x202B;أهلاً بك في GameTranslator&#x202C;" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="&#x202B;يقرأ ترجمة ألعاب PS5 الإنجليزية من الشاشة ويعرضها بالعربية على تلفزيونك فوراً.&#x202C;" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Gerekenler" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Gereksinim 1 -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PS5" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                <TextBlock Text="&#x202B;يكون مشغّلاً وعلى نفس شبكة هذا الكمبيوتر.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gereksinim 2 -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.Tv}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="&#x202B;تلفزيون أو شاشة&#x202C;" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                <TextBlock Text="&#x202B;سامسونج أو LG أو Android TV. إن لم يوجد تلفزيون يمكن عرض الترجمة على شاشة الكمبيوتر.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gereksinim 3 -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.People}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="&#x202B;حساب PSN ثانٍ (مجاني)&#x202C;" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                <TextBlock Text="&#x202B;يتصل الكمبيوتر بهذا الحساب، فلا يتأثر لعبك ولا يد التحكم.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== ADIM 2: PS5 KONSOLU & EŞLEŞTİRME ==================== -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource accentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x202B;اربط الـPS5&#x202C;" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="&#x202B;سجّل الدخول بالحساب الثاني ثم أدخل الرمز الظاهر على الـPS5. يتم مرة واحدة.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- BİLGİ KARTI: TEK SEFERLİK KURULUM VE SESSİZ ARKA PLAN ÇALIŞMASI -->
                    <Border Background="#101726" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="&#x202B;بعدها يتصل البرنامج بالـPS5 تلقائياً، ولا تحتاج لفتح أي شيء آخر.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                        </Grid>
                    </Border>

                    <!-- KART 1: PSN HESAP GİRİŞİ (2. Kullanıcı Hesabı) -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x202B;1. سجّل الدخول بالحساب الثاني&#x202C;" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                <Button Content="&#x202B;الصق الرمز يدوياً&#x202C;" Click="OnToggleManualPsnCode" HorizontalAlignment="Right" Style="{StaticResource PillButton}" />
                            </Grid>

                            <TextBlock Text="&#x202B;كلمة المرور تذهب مباشرة لصفحة Sony، والبرنامج لا يراها.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="15" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PsnSignInButton" Content="&#x202B;افتح تسجيل دخول PSN&#x202C;" Click="OnOpenSonyLogin" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="16,8" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Grid.Column="1" x:Name="PsnStatusText" Text="&#x202B;اضغط الزر وسجّل الدخول في الصفحة التي تفتح.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                            </Grid>

                            <!-- Alternatif Kod / Token Girişi (İsteğe bağlı açılır) -->
                            <Border x:Name="ManualPsnCard" Background="{DynamicResource wellBrush}" CornerRadius="6" Padding="10" Margin="0,4,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="&#x202B;الصق هنا العنوان الظاهر في المتصفح (الذي يحتوي code=...):&#x202C;" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="&#x202B;صفحة الدخول&#x202C;" Click="OnOpenExternalSonyBrowser" HorizontalAlignment="Right" Style="{StaticResource PillButton}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PsnCodeInput" MinHeight="28" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="0,0,6,0" ToolTip="&#x202B;الصق رابط التحويل أو قيمة code=...&#x202C;" />
                    <Button x:Name="PsnVerifyButton" Grid.Column="1" Content="&#x202B;تحقّق&#x202C;" Click="OnVerifyPsnCode" Style="{StaticResource PillButton}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- KART 2: PS5 KONSOLUNU EŞLEŞTİRME -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#x202B;2. الإقران مع الـPS5&#x202C;" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="&#x202B;في الـPS5 وأنت على الحساب الثاني: الإعدادات › النظام › اللعب عن بُعد › ربط جهاز. يظهر رمز من 8 أرقام.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="16" />

                            <!-- Konsol IP Seçimi & Arama -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x202B;عنوان الـPS5:&#x202C;" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource textPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="Ps5HostInput" Text="" MinHeight="32" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="13" Padding="8,4" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="&#x202B;ابحث في الشبكة&#x202C;" Click="OnScanPs5" Style="{StaticResource PillButton}" />
                            </Grid>

                            <!-- 8 Haneli PIN Kodu -->
                            <Border Background="{DynamicResource wellBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x202B;الرمز المكوّن من 8 أرقام:&#x202C;" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="Ps5PinInput" Text="" MinHeight="42" Width="220" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="18" FontWeight="Bold" TextAlignment="Center" MaxLength="8" Padding="4" />
                                </StackPanel>
                            </Border>

                            <!-- BÜYÜK BİRİNCİL EŞLEŞTİR BUTONU -->
                            <Button x:Name="PairButton" Click="OnPairPs5" Background="{DynamicResource successBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" MinHeight="46" FontSize="15" Cursor="Hand" Margin="0,0,0,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x202B;إقران &#x202C;" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="PairStatusText" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource successBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                            <!-- Alternatif: Yakalama Kartı (Capture Card) / OBS Kullanıcıları İçin -->
                            <Border Background="#101726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#x202B;هل تستخدم كرت التقاط أو OBS؟&#x202C;" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="&#x202B;إذن لا حاجة للإقران؛ تؤخذ الصورة من الكرت أو من OBS.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                  <Button Grid.Column="1" Content="&#x202B;اختر هذا &#x202C;" Click="OnSkipPs5ForCaptureCard" Style="{StaticResource PillButton}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== ADIM 3: AKILLI TV ==================== -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource successSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x202B;أين تظهر الترجمة؟&#x202C;" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="&#x202B;اختر تلفزيونك. إن لم يوجد تلفزيون فاختر شاشة الكمبيوتر.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Platform Seçim Kartları (Tıklanabilir Butonlar) -->
                    <StackPanel Margin="0,0,0,14">
                        <!-- 1. PC & OBS -->
                        <Button Click="OnSelectTvPc" Style="{StaticResource PlainCardButton}" Margin="0,0,0,8">
                            <Border x:Name="TvBorderPc" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="2" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="&#x202B;شاشة الكمبيوتر&#x202C;" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="&#x202B;إذا كنت تلعب على شاشة كمبيوتر أو تبث عبر OBS.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgePc" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="&#x202B;تم الاختيار&#x202C;" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 2. Samsung Smart TV -->
                        <Button Click="OnSelectTvSamsung" Style="{StaticResource PlainCardButton}" Margin="0,0,0,8">
                            <Border x:Name="TvBorderSamsung" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="&#x202B;تلفزيون سامسونج&#x202C;" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="&#x202B;موديلات 2019 وما بعدها.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeSamsung" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="&#x202B;تم الاختيار&#x202C;" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 3. LG webOS TV -->
                        <Button Click="OnSelectTvLg" Style="{StaticResource PlainCardButton}" Margin="0,0,0,8">
                            <Border x:Name="TvBorderLg" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="&#x202B;تلفزيون LG&#x202C;" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="&#x202B;الموديلات العاملة بنظام webOS.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeLg" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="&#x202B;تم الاختيار&#x202C;" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 4. Android TV / Google TV -->
                        <Button Click="OnSelectTvAndroid" Style="{StaticResource PlainCardButton}">
                            <Border x:Name="TvBorderAndroid" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Android TV / Google TV" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="&#x202B;TCL وPhilips وXiaomi وSony وأجهزة التلفزيون الخارجية.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeAndroid" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="&#x202B;تم الاختيار&#x202C;" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Seçilen Platform Detay Paneli -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <!-- Panel: PC / OBS -->
                            <StackPanel x:Name="TvDetailPc" Visibility="Visible">
                                <TextBlock Text="&#x202B;تم اختيار شاشة الكمبيوتر&#x202C;" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource successBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="&#x202B;لا تحتاج لإعداد تلفزيون. إن كنت تستخدم OBS فأضف هذا العنوان كمصدر متصفح:&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="http://localhost:8787/obs" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                  <Button Content="&#x202B;انسخ العنوان&#x202C;" HorizontalAlignment="Right" Click="OnCopyObsUrl" Style="{StaticResource PillButton}" />
                                </Grid>
                            </StackPanel>

                            <!-- Panel: Samsung Tizen TV -->
                            <StackPanel x:Name="TvDetailSamsung" Visibility="Collapsed">
                                <TextBlock Text="&#x202B;تلفزيون سامسونج&#x202C;" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="&#x202B;اكتب عنوان التلفزيون واضغط «حفظ واتصال». البرنامج يثبّت تطبيق التلفزيون بنفسه ويفتحه:&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SamsungHostInput" Text="192.168.1.108" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13" />
                                    <Button Grid.Column="1" Content="حفظ واتصال" Click="OnSaveSamsung" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,4" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                  <Button Content="&#x202B;ملف تطبيق التلفزيون&#x202C;" Click="OnOpenSamsungWgt" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                  <Button Content="&#x202B;دليل إعداد التلفزيون (PDF)&#x202C;" Click="OnOpenGuidePdf" Style="{StaticResource PillButton}" />
                                </StackPanel>
                                <!-- Arabic edition: the card that installs the TV app (developer mode steps, Samsung sign-in,
                                     progress, errors). The redesigned setup screen only saved the TV's address and never
                                     installed anything, so nothing could appear on the TV. -->
                                <s:TvAppCard x:Name="SamsungTvAppCard" Margin="0,12,0,0" />
                            </StackPanel>

                            <!-- Panel: LG webOS TV -->
                            <StackPanel x:Name="TvDetailLg" Visibility="Collapsed">
                                <TextBlock Text="&#x202B;تلفزيون LG&#x202C;" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="&#x202B;اكتب عنوان التلفزيون. إذا طلب التلفزيون الموافقة فاقبل بالريموت:&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LgHostInput" Text="192.168.1.108" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13" />
                                    <Button Grid.Column="1" Content="&#x202B;اتصال&#x202C;" Click="OnSaveLg" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,4" />
                                </Grid>
                <Button Content="&#x202B;ملف تطبيق التلفزيون&#x202C;" Click="OnOpenLgIpk" Style="{StaticResource PillButton}" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- Panel: Android TV -->
                            <StackPanel x:Name="TvDetailAndroid" Visibility="Collapsed">
                                <TextBlock Text="Android TV" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="&#x202B;اكتب عنوان التلفزيون أو ابحث عنه، ثم ثبّت التطبيق بضغطة واحدة:&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AndroidHostInput" Text="" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13" />
                  <Button x:Name="ScanAndroidTvButton" Grid.Column="1" Content="&#x202B;ابحث عن التلفزيون&#x202C;" Click="OnScanAndroidTv" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                  <Button Grid.Column="2" Content="&#x202B;حفظ فقط&#x202C;" Click="OnSaveAndroid" Style="{StaticResource PillButton}" />
                                </Grid>

                                <!-- TEK TIKLA ADB İLE KURMA BUTONU -->
                                <Button x:Name="AndroidInstallButton" Content="&#x202B;ثبّت على التلفزيون وافتح&#x202C;" Click="OnInstallAndroidApp" Background="{DynamicResource successBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" MinHeight="38" FontSize="15" Cursor="Hand" Margin="0,0,0,8">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- ADB Durum ve Yönerge Paneli -->
                                <Border Background="{DynamicResource wellBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="&#x202B;إذا لم ينجح التثبيت:&#x202C;" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="&#x202B;• في التلفزيون: الإعدادات › تفضيلات الجهاز › حول › اضغط 7 مرات على رقم الإصدار (Build).&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBlock Text="&#x202B;• من خيارات المطوّر فعّل «تصحيح أخطاء USB / الشبكة».&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="AndroidInstallStatus" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                  <Button Content="&#x202B;ملف تطبيق التلفزيون&#x202C;" Click="OnOpenAndroidApk" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                  <Button Content="&#x202B;دليل إعداد التلفزيون (PDF)&#x202C;" Click="OnOpenGuidePdf" Style="{StaticResource PillButton}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="TvStatusFeedback" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource successBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== ADIM 4: TEST & BİTTİ ==================== -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource successSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x202B;كل شيء جاهز!&#x202C;" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="&#x202B;من الآن يكفي أن تضغط زر البدء.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="&#x202B;طريقة الاستخدام&#x202C;" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,0,10" />
                            <TextBlock Text="&#x202B;1. فعّل الترجمة (Subtitles) داخل اللعبة.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="&#x202B;2. ابدأ الترجمة بالزر الكبير في الشاشة الرئيسية.&#x202C;" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="&#x202B;3. افتح GameTranslator على التلفزيون؛ تظهر الترجمة فوق اللعبة.&#x202C;" FontSize="13" Foreground="{DynamicResource successBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="&#x202B;جرّب على الشاشة&#x202C;" Click="OnTestDesktopOverlay" Style="{StaticResource PillButton}" MinHeight="36" FontWeight="SemiBold" />
            <Button Grid.Column="2" Content="&#x202B;جرّب على التلفزيون&#x202C;" Click="OnTestTv" Style="{StaticResource PillButton}" MinHeight="36" FontWeight="SemiBold" />
                    </Grid>

                    <Button Content="&#x202B;إلى الشاشة الرئيسية&#x202C;" Visibility="Collapsed" Click="OnSkipToMain" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" MinHeight="42" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
