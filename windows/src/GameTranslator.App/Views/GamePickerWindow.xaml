<Window x:Class="GameTranslator.App.Views.GamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x202B;اختر اللعبة&#x202C;" Width="440" Height="560" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource textPrimaryBrush}">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="&#x202B;أي لعبة تلعب؟&#x202C;" Style="{StaticResource TitleText}" FontSize="20" />
            <TextBlock Text="&#x202B;تُستخدم الترجمات الجاهزة للعبة المختارة من أول جملة، ولا تختلط بها ترجمات ألعاب أخرى.&#x202C;"
                       Style="{StaticResource HintText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14" />
            <Grid Margin="0,0,0,12">
                <TextBox x:Name="Search" TextChanged="OnSearch" MinHeight="34" VerticalContentAlignment="Center" Padding="30,0,8,0" />
                <TextBlock Text="&#xE721;" Style="{StaticResource GlyphText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource textTertiaryBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="&#x202B;ابحث عن لعبة&#x202C;" Margin="31,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource textTertiaryBrush}" IsHitTestVisible="False" />
            </Grid>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Kapat" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                Margin="0,14,0,0" IsCancel="True" Click="OnClose" />
        <Border Style="{StaticResource Glass}" Padding="6,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="List" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
