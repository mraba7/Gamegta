<UserControl x:Class="GameTranslator.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:t="clr-namespace:GameTranslator.App.Theme"
             xmlns:local="clr-namespace:GameTranslator.App.Views"
             Background="Transparent" Foreground="{DynamicResource textPrimaryBrush}">
    <Grid>
        <!-- ===== AYARLAR: ayrıntılı ekran (dişliyle açılır) ===== -->
        <Grid x:Name="SettingsLayer" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <!-- Sol Panel: Çeviri Merkezi (Hub) -->
            <ColumnDefinition Width="388" MinWidth="360" MaxWidth="420" />
            <!-- Dikey Ayırıcı Çizgi -->
            <ColumnDefinition Width="1" />
            <!-- Sağ Panel: 5 Sekmeli Ayarlar & Monitör -->
            <ColumnDefinition Width="*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- SOL PANEL: Çeviri Merkezi (Translation Hub)                -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Padding="22,20,14,18">
            <DockPanel>
                <!-- Başlık: logo, uygulama adı, ayarlar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,8,10">
                    <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnBackHome" ToolTip="Ana ekrana dön">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource GlyphText}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Geri" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Ayarlar" Style="{StaticResource LargeTitleText}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Alt: hakkında -->
                <Button x:Name="AboutButton" DockPanel.Dock="Bottom" Content="GameTranslator Hakkında" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Center" Margin="0,12,8,0" Click="OnAbout" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">

                        <!-- Bağlantılar -->
                        <TextBlock Text="Bağlantılar" Style="{StaticResource SectionText}" Margin="14,0,0,7" />
                        <Border Style="{StaticResource Glass}" Padding="14,4" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#5E5CE6">
                                        <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="15" HorizontalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="PS5" FontWeight="SemiBold" FontSize="14" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Ps5StatusDot" Width="7" Height="7" Fill="{DynamicResource successBrush}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Ps5StatusLabel" Text="{Binding Ps5StatusText}" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Ayarla" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="OnReinstall" />
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource hairlineBrush}" Margin="41,0,0,0" />
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#BF5AF2">
                                        <TextBlock Text="{x:Static c:Glyphs.Tv}" Style="{StaticResource GlyphText}" FontSize="15" HorizontalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="TV" FontWeight="SemiBold" FontSize="14" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="TvStatusDot" Width="7" Height="7" Fill="{DynamicResource successBrush}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TvStatusLabel" Text="{Binding TvStatusText}" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="TvActionButton" Grid.Column="2" Content="Ayarla" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="OnTvActionButton" />
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource hairlineBrush}" Margin="41,0,0,0" />
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource accentBrush}">
                                        <TextBlock Text="{x:Static c:Glyphs.Captions}" Style="{StaticResource GlyphText}" FontSize="15" HorizontalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="11,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="PC ekranında altyazı" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        <Ellipse x:Name="OverlayStatusDot" Width="7" Height="7" Fill="{DynamicResource idleBrush}" Margin="8,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="OverlayToggleButton" Grid.Column="2" Content="Kapalı" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="OnToggleOverlayButton" />
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource hairlineBrush}" Margin="41,0,0,0" />
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#FF9F0A">
                                        <TextBlock Text="&#xE767;" Style="{StaticResource GlyphText}" FontSize="15" HorizontalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="PC sesi" FontWeight="SemiBold" FontSize="14" Margin="11,0,8,0" VerticalAlignment="Center" />
                                    <Button x:Name="PcSesiButton" Grid.Column="2" Content="Sessiz" Style="{StaticResource PillButton}" FontWeight="SemiBold" VerticalAlignment="Center"
                                            Foreground="{DynamicResource dangerBrush}" Background="{DynamicResource dangerSoftBrush}" Click="OnPcSesiToggle" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Okuma alanı kısayolu ve canlı önizleme -->
                        <TextBlock Text="Oyun görüntüsü" Style="{StaticResource SectionText}" Margin="14,0,0,7" />
                        <Border Style="{StaticResource Glass}" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="2,0,2,9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="StreamThumbnailDot" Width="7" Height="7" Fill="{DynamicResource successBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StreamThumbnailTitle" Text="PS5 görüntüsü" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="StreamThumbnailBadge" Text="1080p CANLI" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource Well}" Height="150" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ThumbnailStreamImage" Stretch="UniformToFill" />
                                        <StackPanel x:Name="ThumbnailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="26" Foreground="{DynamicResource textTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ThumbnailStatusText" Text="Görüntü bekleniyor" FontSize="12" Foreground="{DynamicResource textTertiaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button Click="OnOcrShortcut" Cursor="Hand" Margin="0,10,0,0" HorizontalAlignment="Stretch" ToolTip="Altyazının nereden okunacağını ayarla">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Row" Background="{DynamicResource cardStrongBrush}" CornerRadius="12" Padding="12,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Okuma alanı" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource textPrimaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ShortcutPresetText" Text="Otomatik" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="11" Margin="8,1,0,0" Foreground="{DynamicResource textTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Son altyazı -->
                        <Grid Margin="14,0,4,7">
                            <TextBlock Text="Son altyazı" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="LiveBadgeText" Text="Canlı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource successBrush}" />
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Glass}" MinHeight="78" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Oynarken son altyazı burada görünür." Style="{StaticResource HintText}" FontSize="13"
                                           Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding LastTranslation}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource textPrimaryBrush}" LineHeight="21"
                                           Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                                <TextBlock Text="{Binding LastSource}" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,6,0,0" LineHeight="17"
                                           Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </Border>

                        <!-- Altyazı geçmişi -->
                        <Grid Margin="14,0,0,7">
                            <TextBlock Text="Altyazı geçmişi" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Temizle" Style="{StaticResource PillButton}" Margin="0,0,6,0" Click="OnClearHistory" ToolTip="Geçmişi siler (kayıtlı dosyadaki de)" />
                                <Button Content="TXT" Style="{StaticResource PillButton}" Margin="0,0,6,0" Click="OnExportTxt" ToolTip="Geçmişi metin dosyası olarak kaydet" />
                                <Button Content="JSON" Style="{StaticResource PillButton}" Click="OnExportJson" ToolTip="Geçmişi JSON olarak kaydet" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Glass}" Padding="6" Height="132">
                            <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource textPrimaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Dikey Ayırıcı Çizgi -->
        <Rectangle Grid.Column="1" Fill="Transparent" Width="1" HorizontalAlignment="Stretch" />

        <!-- ========================================================= -->
        <!-- SAĞ PANEL: 5 Sekmeli Ayarlar & Monitör                     -->
        <!-- ========================================================= -->
        <Border Grid.Column="2" Padding="14,20,22,18">
            <DockPanel>
                <!-- 5'li Segmented Tab Başlıkları (Mac'teki Sekmeler) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="TabOcrArea" Grid.Column="0" Content="Okuma Alanı" IsChecked="True" Checked="OnTabChanged"
                                     Style="{StaticResource SegmentButton}" FontSize="12" />
                        <RadioButton x:Name="TabDisplay" Grid.Column="1" Content="TV Görünümü" Checked="OnTabChanged"
                                     Style="{StaticResource SegmentButton}" FontSize="12" />
                        <RadioButton x:Name="TabModels" Grid.Column="2" Content="Modeller" Checked="OnTabChanged"
                                     Style="{StaticResource SegmentButton}" FontSize="12" />
                        <RadioButton x:Name="TabSystem" Grid.Column="3" Content="Bağlantı" Checked="OnTabChanged"
                                     Style="{StaticResource SegmentButton}" FontSize="12" />
                        <RadioButton x:Name="TabGuide" Grid.Column="4" Content="Rehber" Checked="OnTabChanged"
                                     Style="{StaticResource SegmentButton}" FontSize="12" />
                    </Grid>
                </Border>

                <!-- Alt Çubuk (Footer) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Kurulumu baştan yap" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnReinstall" />
                            <Button Content="Ayarları sıfırla" Style="{StaticResource SecondaryButton}" Foreground="{DynamicResource dangerBrush}" Click="OnResetAll" />
                        </StackPanel>
                        <Button Content="Bitti" HorizontalAlignment="Right" MinWidth="84" MinHeight="32"
                                Background="{DynamicResource accentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="OnDone">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Sekme İçerikleri (ScrollViewer) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ========================================================= -->
                        <!-- 1. SEKME: OYUN OKUMA ALANI (PS5 Canlı Akışı & OCR Kutusu)  -->
                        <!-- ========================================================= -->
                        <StackPanel x:Name="PanelOcrArea" Visibility="Visible">
                            <!-- Başlık & Açıklama -->
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Altyazının okunduğu yer" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Çoğu oyunda Otomatik yeterli: uygulama altyazının yerini kendisi bulur. Bulamazsa aşağıdan bir yer seç ya da mavi kutuyu ayarla."
                                           Style="{StaticResource HintText}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Hazır Şablonlar (Presets) -->
                            <WrapPanel Margin="0,0,0,6">
                <Button x:Name="PresetAuto" Content="Otomatik (Önerilen)" Tag="Auto" Click="OnPresetClick" Style="{StaticResource PillButton}" Margin="0,0,6,6" 
                                        ToolTip="Uygulama altyazının yerini kendisi bulur; menüleri, ipuçlarını ve göstergeleri yok sayar." />
                <Button x:Name="PresetBottomCenter" Content="Alt Orta (Standart)" Tag="BottomCenter" Click="OnPresetClick" Style="{StaticResource PillButton}" Margin="0,0,6,6" />
                <Button x:Name="PresetBottomWide" Content="Geniş Alt Bant" Tag="BottomWide" Click="OnPresetClick" Style="{StaticResource PillButton}" Margin="0,0,6,6" />
                <Button x:Name="PresetFullBottom" Content="Tüm Alt Yarı" Tag="FullBottom" Click="OnPresetClick" Style="{StaticResource PillButton}" Margin="0,0,6,6" />
                <Button x:Name="PresetTopBanner" Content="Üst Bölge (Görevler)" Tag="TopBanner" Click="OnPresetClick" Style="{StaticResource PillButton}" Margin="0,0,6,6" />
                <Button x:Name="PresetCustom" Content="Özel Kutu" Tag="Custom" Click="OnPresetClick" Style="{StaticResource PillButton}" Margin="0,0,6,6" />
                            </WrapPanel>

                            <!-- Hızlı Görüntü Kaynağı ve Hedef Pencere Seçimi (Yakalama Kartı / OBS / Belirli Pencere) -->
                            <Border x:Name="QuickSourcePickerCard" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Yakalanacak Pencere / Ekran:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="QuickSourceWindowComboBox" Grid.Column="1" SelectionChanged="OnQuickSourceWindowSelected" MinHeight="28" FontSize="13" VerticalContentAlignment="Center" />
                  <Button Grid.Column="2" Content="Pencereleri Yenile" Click="OnRefreshWindows" Style="{StaticResource PillButton}" Margin="8,0,0,0" ToolTip="Açık oyun ve OBS pencerelerini yeniden listele" />
                                </Grid>
                            </Border>

                            <!-- 16:9 GERÇEK OYUN GÖRÜNTÜSÜ & OCR ALGILAMA KUTUSU -->
                            <Border Background="{DynamicResource wellBrush}" BorderBrush="{DynamicResource textTertiaryBrush}" BorderThickness="1.5" CornerRadius="8" Height="230" ClipToBounds="True" Margin="0,0,0,10">
                                <Grid>
                                    <!-- Canlı Video Akışı -->
                                    <Image x:Name="LiveStreamImage" Stretch="Uniform" />

                                    <!-- Canlı Akış Kapalıyken Gösterilecek Kalibrasyon Zemin Deseni -->
                                    <StackPanel x:Name="StreamPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="StreamPlaceholderIcon" Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="28" Foreground="{DynamicResource textTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="StreamPlaceholderTitle" Text="Görüntü yok" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,2" />
                                        <TextBlock x:Name="StreamPlaceholderSubtitle" Text="Görüntüyü görmek için çeviriyi başlat." FontSize="12" Foreground="{DynamicResource textTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </StackPanel>

                                    <!-- Üst Rozet & Yenile Butonu -->
                                    <Grid VerticalAlignment="Top" Margin="8">
                                        <Border HorizontalAlignment="Left" Background="#CC000000" CornerRadius="12" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource successBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="CANLI GÖRÜNTÜ" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Yenile" Style="{StaticResource PillButton}" Click="OnRefreshCapture" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- OCR Kutusu Tuvali (Dynamic Viewfinder) -->
                                    <Canvas x:Name="OcrCanvas" SizeChanged="OnOcrCanvasSizeChanged">
                                        <Border x:Name="OcrBoxBorder" BorderBrush="{DynamicResource accentTextBrush}" BorderThickness="2" Background="{DynamicResource accentSoftBrush}" CornerRadius="4">
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EE000000" CornerRadius="3" Padding="4,1.5" Margin="2">
                                                <TextBlock Text="OKUNAN ALAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource accentTextBrush}" />
                                            </Border>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- Anlık OCR Algılama & TV Çeviri Monitörü -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Son okunan ve çevrilen" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Sol: PS5 İngilizce -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Oyunda (İngilizce)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="MonitorEnglishText" Text="Okunan yazı burada görünür" FontSize="12" Foreground="{DynamicResource textPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Sağ: TV Türkçe -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TV'de (Türkçe)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="MonitorTurkishText" Text="Çevirisi burada görünür" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource textPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Canlı ölçüm: son satırın okuma, çeviri ve kareden TV'ye gecikme süresi -->
                                    <TextBlock Text="{Binding MetricsText}" FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="Son satır: yazı tanıma, çeviri ve görüntünün gelişinden TV'ye toplam gecikme" />
                                </StackPanel>
                            </Border>

                            <!-- 4 Koordinat Slider'ı (Üst, Alt, Sol, Sağ) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Sol Kolon: Üst Başlangıç & Sol Sınır -->
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Üst" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CropTopLabel" Text="%72" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="CropTopSlider" Minimum="0" Maximum="0.85" Value="0.72" ValueChanged="OnCropSliderChanged" Margin="0,0,0,6" IsMoveToPointEnabled="True" />

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Sol" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CropLeftLabel" Text="%16" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="CropLeftSlider" Minimum="0" Maximum="0.45" Value="0.16" ValueChanged="OnCropSliderChanged" IsMoveToPointEnabled="True" />
                                </StackPanel>

                                <!-- Sağ Kolon: Alt Bitiş & Sağ Sınır -->
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Alt" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CropBottomLabel" Text="%85" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="CropBottomSlider" Minimum="0.15" Maximum="1.0" Value="0.85" ValueChanged="OnCropSliderChanged" Margin="0,0,0,6" IsMoveToPointEnabled="True" />

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Sağ" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CropRightLabel" Text="%84" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="CropRightSlider" Minimum="0.55" Maximum="1.0" Value="0.84" ValueChanged="OnCropSliderChanged" IsMoveToPointEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- 2. SEKME: TV GÖRÜNÜMÜ (Renk, Boyut, Canlı TV Önizleme)      -->
                        <!-- ========================================================= -->
                        <StackPanel x:Name="PanelDisplay" Visibility="Collapsed">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="TV Altyazı Görünümü" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" />
                                <TextBlock Text="TV ekranınızdaki altyazının boyutunu, rengini ve konumunu canlı özelleştirin." Style="{StaticResource HintText}" FontSize="13" />
                            </StackPanel>

                            <!-- Yazı Rengi Seçici -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Yazı rengi:" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <!-- Beyaz -->
                                    <Button Click="OnColorWhite" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border x:Name="ColorWhiteBorder" Width="24" Height="24" CornerRadius="12" Background="#FFFFFF" BorderBrush="#0A84FF" BorderThickness="2" />
                                    </Button>
                                    <!-- Sarı -->
                                    <Button Click="OnColorYellow" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border x:Name="ColorYellowBorder" Width="24" Height="24" CornerRadius="12" Background="#FFE600" BorderBrush="Transparent" BorderThickness="2" />
                                    </Button>
                                    <!-- Camgöbeği -->
                                    <Button Click="OnColorCyan" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border x:Name="ColorCyanBorder" Width="24" Height="24" CornerRadius="12" Background="#38BDF8" BorderBrush="Transparent" BorderThickness="2" />
                                    </Button>
                                    <!-- Yeşil -->
                                    <Button Click="OnColorGreen" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border x:Name="ColorGreenBorder" Width="24" Height="24" CornerRadius="12" Background="#10B981" BorderBrush="Transparent" BorderThickness="2" />
                                    </Button>
                                    <!-- Turuncu -->
                                    <Button Click="OnColorOrange" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border x:Name="ColorOrangeBorder" Width="24" Height="24" CornerRadius="12" Background="#FF9F0A" BorderBrush="Transparent" BorderThickness="2" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Yazı Boyutu & Arka Plan Opaklığı -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Yazı boyutu (TV)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TextSizeLabel" Text="46 px" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="TextSizeSlider" Minimum="24" Maximum="72" Value="46" ValueChanged="OnTextSize" IsMoveToPointEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Arka plan opaklığı" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BackgroundLabel" Text="%72" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="BackgroundSlider" Minimum="0" Maximum="100" Value="72" ValueChanged="OnBackground" IsMoveToPointEnabled="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Ekran Konumu (Alttan Yükseklik) -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Ekran Konumu (Alttan Yükseklik)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BottomPercentLabel" Text="%7" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="BottomPercentSlider" Minimum="2" Maximum="30" Value="7" ValueChanged="OnBottomPercent" IsMoveToPointEnabled="True" />
                            </StackPanel>

                            <!-- Yerleşim & Oyun Dili Dropdown'ları -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Yeri:" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,3" />
                                    <ComboBox x:Name="PlacementBox" SelectionChanged="OnPlacement" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="İngilizce altyazının üstünü örtsün" Tag="Cover" IsSelected="True" />
                                        <ComboBoxItem Content="İngilizce altyazının üstünde" Tag="Above" />
                                        <ComboBoxItem Content="İngilizce altyazının altında" Tag="Below" />
                                        <ComboBoxItem Content="Ekranda sabit yükseklikte" Tag="Fixed" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Oyunun dili:" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,3" />
                                    <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguage" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="İngilizce" Tag="en" IsSelected="True" />
                                        <ComboBoxItem Content="Japonca" Tag="ja" />
                                        <ComboBoxItem Content="Almanca" Tag="de" />
                                        <ComboBoxItem Content="Fransızca" Tag="fr" />
                                        <ComboBoxItem Content="İspanyolca" Tag="es" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Anahtarlar ve deneme düğmeleri -->
                            <Border Style="{StaticResource Glass}" Padding="16,9" Margin="0,0,0,10">
                                <WrapPanel>
                                    <CheckBox x:Name="DesktopOverlayCheck" Content="PC Ekranında Altyazı (Şeffaf Katman)" Checked="OnDesktopOverlayToggle" Unchecked="OnDesktopOverlayToggle" Margin="0,5,22,5" />
                                    <CheckBox x:Name="BoldCheck" Content="Kalın (Bold)" Checked="OnBold" Unchecked="OnBold" Margin="0,5,22,5" />
                                    <CheckBox x:Name="SpeakerColorCheck" Content="Konuşmacı adı renkli" Checked="OnSpeakerColor" Unchecked="OnSpeakerColor" Margin="0,5,22,5" ToolTip="Konuşan kişinin adı (ör. MARKOS:) çevirinin geri kalanından farklı renkte gösterilir." />
                                    <CheckBox x:Name="DubbingCheck" Content="Türkçe Dublaj" Checked="OnDubbing" Unchecked="OnDubbing" Margin="0,5,22,5" />
                                    <CheckBox x:Name="MutePcCheck" Content="PC Sesini Kapat" Checked="OnMutePc" Unchecked="OnMutePc" Margin="0,5,22,5" IsChecked="True" />
                                </WrapPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Ekrana &amp; TV'ye Test Gönder" Click="OnTestSubtitle" Style="{StaticResource TintButton}" Margin="0,0,8,0" />
                                <Button Content="Altyazıyı Konumlandır" Click="OnDragOverlayPosition" Style="{StaticResource SecondaryButton}" ToolTip="3 monitörlü veya özel kurulumlarda altyazıyı istediğiniz ekrana sürükleyin" />
                            </StackPanel>

                            <!-- CANLI TV ÖNİZLEME (16:9 Ekran Çerçevesi) -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="CANLI TV ÖNİZLEME (ÇEVİRİ YANSITMA ALANI)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="1920 x 1080 (16:9)" HorizontalAlignment="Right" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Background="{DynamicResource wellBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="1.5" CornerRadius="7" Height="125" ClipToBounds="True">
                                        <Grid VerticalAlignment="Bottom" Margin="0,0,0,12">
                                            <Border x:Name="TvPreviewSubtitleBox" HorizontalAlignment="Center" Background="#B8000000" CornerRadius="4" Padding="14,6">
                                                <TextBlock x:Name="TvPreviewSubtitleText" Text="HERHANGİ BİR DÜĞMEYE BASIN" FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- 3. SEKME: ÇEVİRİ & MODELLER                                -->
                        <!-- ========================================================= -->
                        <StackPanel x:Name="PanelModels" Visibility="Collapsed">
                            <!-- 0ms TOPLULUK OYUN YAMALARI KARTI -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource successBrush}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Topluluk Oyun Yamaları (0 ms Gecikme)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <CheckBox x:Name="CheckCommunityPatches" Content="Aktif" IsChecked="True" Checked="OnPatchToggleChanged" Unchecked="OnPatchToggleChanged" Foreground="{DynamicResource successBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" />
                                            <Border Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource successBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="%100 İnsan Çevirisi" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Oyunu elle seçme: paket ilk satırdan kullanılır, başka oyunların paketleri karışmaz -->
                                    <Border Style="{StaticResource Glass}" Padding="6,2" Margin="0,0,0,4">
                                        <Button Style="{StaticResource RowButton}" Click="OnGameShortcut">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Oynadığın oyun" FontSize="14" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock x:Name="GameSelectText" Text="Otomatik" FontSize="14" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="11" Margin="8,1,0,0" Foreground="{DynamicResource textTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <TextBlock Text="Otomatik'te oyun ilk birkaç cümleden anlaşılır. Oyunu seçersen çeviri ilk cümleden itibaren paketten gelir." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <!-- Ortak havuz (CouchSubs): pakette olmayan satırlar yeni paketler için anonim gönderilir -->
                                    <CheckBox x:Name="SharePoolCheck" Content="Pakette olmayan satırları ortak havuza gönder" Checked="OnSharePool" Unchecked="OnSharePool" Margin="0,0,0,4" Cursor="Hand" />
                                    <TextBlock Text="Yeni oyun paketleri bunlardan hazırlanır. Yalnız oyundaki İngilizce satırın metni ve PS5'te çalışan oyunun adı gider; adın, PSN hesabın ya da IP adresin gitmez. Kapatınca bekleyen satırlar da silinir." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <!-- Desteklenen Oyunlar ve Canlı Yama Durumu Metni -->
                                    <Border Background="{DynamicResource wellBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <TextBlock x:Name="PatchStatusText" Text="Desteklenen Oyunlar taranıyor..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Aksiyon Butonları (Otomatik Tara & İçe Aktar) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Paketleri Tara ve Güncelle" Click="OnScanPatchesClick" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Hem yerel diskteki paketleri (%LOCALAPPDATA%\GameTranslator\packs) hem de resmi depodaki en güncel paketleri otomatik tarar ve eşler" />
                    <Button Grid.Column="1" Content="Yama Yükle (.json, .srt)" Click="OnImportPatchClick" Style="{StaticResource PillButton}" FontWeight="SemiBold" ToolTip="Kendi hazırladığınız veya indirdiğiniz özel yama dosyasını içeri aktarın" />
                                    </Grid>

                                    <TextBlock Text="Yamada kayıtlı olan replikler oyun esnasında otomatik tanınır ve 0 milisaniyede televizyonunuza yansıtılır. Yamada olmayan yan diyaloglar seçtiğiniz yapay zeka motoruyla tamamlanır." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Yapay Zeka &amp; Çeviri Motoru Seçimi" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Yamada yer almayan replikler için kullanılacak çeviri motorunu belirleyin." Style="{StaticResource HintText}" FontSize="13" Margin="0,0,0,12" />

                            <!-- Arabic edition: quality mode. "Best" uses the strongest model of the chosen AI service, "Fastest" its quick one. -->
                            <Border x:Name="BorderQuality" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="وضع الترجمة" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadioQualityBest" GroupName="QualityModeGroup" Checked="OnQualitySelected" Content="أقوى جودة" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,0,24,0" Cursor="Hand" />
                                        <RadioButton x:Name="RadioQualityFastest" GroupName="QualityModeGroup" Checked="OnQualitySelected" Content="أسرع" FontWeight="Bold" FontSize="13" Foreground="White" Cursor="Hand" />
                                    </StackPanel>
                                    <TextBlock x:Name="QualityHint" Text="" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Model 1: DirectML Yerel Model -->
                            <Border x:Name="BorderDirectMl" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                    MouseLeftButtonUp="OnCardDirectMlClick" Cursor="Hand">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioModelDirectMl" GroupName="TranslationModelGroup" Checked="OnModelSelected"
                                                     Content="Donanım Hızlandırmalı Yerel Yapay Zeka (DirectML)" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" IsChecked="True" Cursor="Hand" />
                                        <Border x:Name="BadgeDirectMl" HorizontalAlignment="Right" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource successBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Aktif / Seçili" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="LocalModelDescription" Text="Bilgisayarınızın ekran kartını (DirectML) ve CPU'sunu kullanarak tamamen çevrimdışı, sıfır gecikmeli çeviri yapar. Kota ve internet gerektirmez."
                                               FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="22,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Model 2: Google Gemini Flash -->
                            <Border x:Name="BorderGemini" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                    MouseLeftButtonUp="OnCardGeminiClick" Cursor="Hand">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioModelGemini" GroupName="TranslationModelGroup" Checked="OnModelSelected"
                                                     Content="Google Gemini" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" Cursor="Hand" />
                                        <Border x:Name="BadgeGemini" HorizontalAlignment="Right" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource successBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Aktif / Seçili" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="GeminiDescription" Text="Oyun jargonu, sokak ağzı ve diyaloglarda insan düzeyinde en akıcı Türkçe altyazı deneyimini sunar." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="22,0,0,8" />
                                    <Grid Margin="22,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="GeminiKeyInput" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Kaydet ve Aktif Et" Click="OnGeminiSave" Style="{StaticResource PillButton}" FontWeight="Bold" />
                                    </Grid>
                                    <TextBlock Margin="22,0,0,0">
                                        <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="OnHyperlink">
                                            <Run Text="Ücretsiz Google Gemini API anahtarı alın " Foreground="{DynamicResource accentBrush}" FontSize="13" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Arabic edition: OpenAi -->
                            <Border x:Name="BorderOpenAi" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                    MouseLeftButtonUp="OnCardOpenAiClick" Cursor="Hand">
                                <StackPanel FlowDirection="RightToLeft">
                                    <Grid Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioModelOpenAi" GroupName="TranslationModelGroup" Checked="OnModelSelected"
                                                     Content="OpenAI (GPT)" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" Cursor="Hand" />
                                        <Border x:Name="BadgeOpenAi" HorizontalAlignment="Right" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource successBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="مفعّل" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="ترجمة بالذكاء الاصطناعي من OpenAI. تحتاج مفتاح API مدفوع من حسابك." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="22,0,0,8" />
                                    <Grid Margin="22,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="OpenAiKeyInput" FlowDirection="LeftToRight" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="حفظ وتفعيل" Click="OnOpenAiSave" Style="{StaticResource PillButton}" FontWeight="Bold" />
                                    </Grid>
                                    <TextBlock Margin="22,0,0,0">
                                        <Hyperlink NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="OnHyperlink">
                                            <Run Text="احصل على مفتاح OpenAI" Foreground="{DynamicResource accentBrush}" FontSize="13" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Arabic edition: Claude -->
                            <Border x:Name="BorderClaude" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                    MouseLeftButtonUp="OnCardClaudeClick" Cursor="Hand">
                                <StackPanel FlowDirection="RightToLeft">
                                    <Grid Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioModelClaude" GroupName="TranslationModelGroup" Checked="OnModelSelected"
                                                     Content="Claude (Anthropic)" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" Cursor="Hand" />
                                        <Border x:Name="BadgeClaude" HorizontalAlignment="Right" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource successBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="مفعّل" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="ترجمة بالذكاء الاصطناعي من Anthropic. تحتاج مفتاح API مدفوع من حسابك." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="22,0,0,8" />
                                    <Grid Margin="22,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ClaudeKeyInput" FlowDirection="LeftToRight" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="حفظ وتفعيل" Click="OnClaudeSave" Style="{StaticResource PillButton}" FontWeight="Bold" />
                                    </Grid>
                                    <TextBlock Margin="22,0,0,0">
                                        <Hyperlink NavigateUri="https://platform.claude.com/settings/keys" RequestNavigate="OnHyperlink">
                                            <Run Text="احصل على مفتاح Claude" Foreground="{DynamicResource accentBrush}" FontSize="13" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Model 3: DeepL API -->
                            <Border x:Name="BorderDeepL" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14"
                                    MouseLeftButtonUp="OnCardDeepLClick" Cursor="Hand">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioModelDeepL" GroupName="TranslationModelGroup" Checked="OnModelSelected"
                                                     Content="DeepL API (Resmi Servis)" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" Cursor="Hand" />
                                        <Border x:Name="BadgeDeepL" HorizontalAlignment="Right" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource successBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Aktif / Seçili" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Resmi DeepL REST API hesabınız ile profesyonel altyazı çevirisi." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="22,0,0,8" />
                                    <Grid Margin="22,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="DeepLKeyInput" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Kaydet ve Aktif Et" Click="OnDeepLSave" Style="{StaticResource PillButton}" FontWeight="Bold" />
                                    </Grid>
                                    <TextBlock Margin="22,0,0,0">
                                        <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="OnHyperlink">
                                            <Run Text="Ücretsiz DeepL API anahtarı alın " Foreground="{DynamicResource accentBrush}" FontSize="13" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- 4. SEKME: BAĞLANTI & SİSTEM                                -->
                        <!-- ========================================================= -->
                        <StackPanel x:Name="PanelSystem" Visibility="Collapsed">
                            <TextBlock Text="Konsol, Giriş Kaynağı ve Ağ Bağlantıları" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,12" />

                            <!-- GÖRÜNTÜ VE VİDEO GİRİŞ KAYNAĞI SEÇİMİ (Remote Play / Capture Card / OBS) -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Görüntü Giriş Kaynağı" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="OBS &amp; Capture Card Destekli" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="Oyun görüntüsünün nereden okunacağını seçin. Capture Card veya OBS kullanıyorsanız PS5 Remote Play'e gerek kalmaz." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="SourceRadioRemotePlay" Content="PS5 Remote Play" GroupName="VideoSourceGroup" Checked="OnVideoSourceChanged" IsChecked="True" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" />
                                        <RadioButton x:Name="SourceRadioCaptureCard" Content="Yakalama Kartı" GroupName="VideoSourceGroup" Checked="OnVideoSourceChanged" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" />
                                        <RadioButton x:Name="SourceRadioDesktop" Content="Masaüstü / OBS" GroupName="VideoSourceGroup" Checked="OnVideoSourceChanged" Foreground="White" FontSize="13" VerticalAlignment="Center" Cursor="Hand" />
                                    </StackPanel>

                                    <!-- Pencere / Monitör Seçimi Kartı (Masaüstü veya Capture Card seçildiğinde) -->
                                    <Border x:Name="SourceWindowPickerCard" Background="{DynamicResource wellBrush}" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Hedef Pencere veya Ekran:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Pencereleri Yenile" Click="OnRefreshWindows" HorizontalAlignment="Right" Style="{StaticResource PillButton}" />
                                            </Grid>
                                            <ComboBox x:Name="SourceWindowComboBox" SelectionChanged="OnSourceWindowSelected" MinHeight="30" FontSize="13">
                                                <ComboBoxItem Content="Tüm Masaüstü / Ana Ekran" Tag="" IsSelected="True" />
                                            </ComboBox>
                                            <TextBlock Text="OBS kullanıyorsanız: OBS'te 'Tam Ekran Projektör' veya 'Pencere Projektörü' açıp listeden seçebilirsiniz." FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- PS5 Kartı -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="15" Foreground="{DynamicResource accentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="PlayStation 5" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="1080p 60 FPS" HorizontalAlignment="Right" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="PS5 konsolunuzda Remote Play etkinleştirilmiş olmalıdır. Kumandanızın TV'den kopmaması için bilgisayar arka planda 2. bir PSN hesabı ile bağlanır."
                                               FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- TV Kartı -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static c:Glyphs.Tv}" Style="{StaticResource GlyphText}" FontSize="15" Foreground="{DynamicResource successBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Akıllı TV &amp; GameTranslator" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Port 8787 (SSE)" HorizontalAlignment="Right" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="TCL / Android TV (APK), LG webOS (IPK) ve Samsung Tizen (WGT) paketleri TV'nize yüklendiğinde otomatik olarak bilgisayarınıza bağlanır."
                                               FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Kısayollar & OBS Overlay Kartı -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Ekranı çevir kısayolu" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" Background="{DynamicResource textTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Num 9 / Alt+T" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource textPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="ObsText" Text="OBS overlay: http://localhost:8787/obs" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Kopyala" HorizontalAlignment="Right" Click="OnCopyObs" Style="{StaticResource PillButton}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- 5. SEKME: HIZLI REHBER                                     -->
                        <!-- ========================================================= -->
                        <StackPanel x:Name="PanelGuide" Visibility="Collapsed">
                            <TextBlock Text="Nasıl Kullanılır? (Hızlı Rehber)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,12" />

                            <!-- 1. PS5 & TV -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource accentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PS5 &amp; TV" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="PS5 konsolunuzu açın ve TV'deki HDMI portuna geçin. PS5 doğrudan TV'ye bağlı kalır." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. TV Uygulaması -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource accentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TV Uygulaması" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="TV'nizde GameTranslator uygulamasını açın. Bilgisayara aynı Wi-Fi üzerinden otomatik olarak bağlanır." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. Okuma Alanı -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource accentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Okuma Alanı" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Oyununuzun altyazı konumuna göre 'Oyun Okuma Alanı' sekmesinden hazır şablon seçin veya mavi kutuyu ayarlayın." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 4. Başlat -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource accentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="4" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Başlat" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Ana ekrandaki mavi '▶ Çeviriyi Başlat' butonuna tıklayın. Konsol görüntüsü taranıp altyazılar TV'ye Türkçe olarak yansır." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 5. TV Görünümü -->
                            <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource accentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="5" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TV Görünümü" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Altyazı rengini (sarı/beyaz), boyutunu ve konumunu zevkinize göre ayarlayın; TV ekranına anında yansır!" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>

        <!-- ===== ANA EKRAN: mobildeki gibi sade ===== -->
        <ScrollViewer x:Name="HomeLayer" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="520" Margin="24,14,24,18">
                <!-- Başlık -->
                <Grid Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,11,0" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock Text="GameTranslator" Style="{StaticResource LargeTitleText}" FontSize="24" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnSettingsButton" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource cardStrongBrush}">
                            <TextBlock Text="{x:Static c:Glyphs.Settings}" Style="{StaticResource GlyphText}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource textPrimaryBrush}" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Büyük başlat / durdur düğmesi (mobildeki gibi) -->
                <Grid Height="172" Margin="0,0,0,0">
                    <Ellipse Width="190" Height="190" Fill="{DynamicResource glowBrush}" IsHitTestVisible="False" />
                    <Ellipse Width="128" Height="128" Fill="{DynamicResource cardBrush}" Stroke="{DynamicResource hairlineBrush}" StrokeThickness="1" IsHitTestVisible="False" />
                    <Button x:Name="Toggle" Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnToggle" Cursor="Hand"
                            IsEnabled="{Binding IsStarting, Converter={StaticResource Not}}" Background="{DynamicResource accentBrush}"
                            ToolTip="Çeviriyi başlat ya da durdur">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Disc" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Disc" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ToggleGlyph" Text="{x:Static c:Glyphs.Play}" Style="{StaticResource GlyphText}" FontSize="34" Foreground="White" />
                    </Button>
                </Grid>
                <TextBlock x:Name="ToggleText" Text="Çeviriyi Başlat" Style="{StaticResource LargeTitleText}" FontSize="22" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="HomeHint" Text="Oyunda altyazıları aç, sonra başlat." Style="{StaticResource HintText}" FontSize="14"
                           TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,16" />

                <!-- PS5 → Bilgisayar → TV -->
                <Border Style="{StaticResource Glass}" Padding="10,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#5E5CE6" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="19" HorizontalAlignment="Center" Foreground="White" />
                            </Border>
                            <TextBlock Text="PS5" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="HomePs5Dot" Width="7" Height="7" Fill="{DynamicResource idleBrush}" Margin="0,1,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="HomePs5Text" Text="Eşleşmedi" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Top" Margin="0,15,0,0" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource accentBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource GlyphText}" FontSize="19" HorizontalAlignment="Center" Foreground="White" />
                            </Border>
                            <TextBlock Text="Bilgisayar" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="HomePcDot" Width="7" Height="7" Fill="{DynamicResource idleBrush}" Margin="0,1,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="HomePcText" Text="Hazır" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Top" Margin="0,15,0,0" />
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#BF5AF2" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static c:Glyphs.Tv}" Style="{StaticResource GlyphText}" FontSize="19" HorizontalAlignment="Center" Foreground="White" />
                            </Border>
                            <TextBlock Text="TV" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="HomeTvDot" Width="7" Height="7" Fill="{DynamicResource idleBrush}" Margin="0,1,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="HomeTvText" Text="Bağlı değil" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Yalnız bir sorun olduğunda: uyarı -->
                <Border x:Name="HomeNotice" Style="{StaticResource Glass}" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static c:Glyphs.Warning}" Style="{StaticResource GlyphText}" FontSize="16" Foreground="{DynamicResource warningBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="HomeNoticeTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock x:Name="HomeNoticeText" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Çeviri açıkken: son çeviri -->
                <Border Style="{StaticResource Glass}" Padding="16,14" Margin="0,0,0,14" MinHeight="84"
                        Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Text="SON ÇEVİRİ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Oyunda altyazı çıkınca çevirisi burada ve TV'de görünür." Style="{StaticResource HintText}" FontSize="14" TextWrapping="Wrap"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding LastTranslation}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource textPrimaryBrush}" TextWrapping="Wrap" LineHeight="23"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding LastSource}" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                </Border>

                <!-- Çeviri kapalıyken: nasıl kullanılır -->
                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                    <TextBlock Text="NASIL KULLANILIR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" Margin="16,0,0,8" />
                    <Border Style="{StaticResource Glass}" Padding="16,6" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource cardStrongBrush}"><TextBlock Text="1" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="Oyunda altyazıları aç." FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource cardStrongBrush}"><TextBlock Text="2" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="Yukarıdaki düğmeyle çeviriyi başlat." FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource cardStrongBrush}"><TextBlock Text="3" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="TV'de GameTranslator'ı aç; çeviri oyunun üstünde görünür." FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ayrıntılar: ayarlar ekranına kısa yollar -->
                <Border Style="{StaticResource Glass}" Padding="6,4">
                    <StackPanel>
                        <Button Style="{StaticResource RowButton}" Click="OnGameShortcut">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Oyun" FontSize="14" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="HomeGameText" Text="Otomatik" FontSize="14" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="11" Margin="8,1,0,0" Foreground="{DynamicResource textTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Rectangle Height="1" Fill="{DynamicResource hairlineBrush}" Margin="10,0" />
                        <Button Style="{StaticResource RowButton}" Click="OnOcrShortcut">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Altyazının okunduğu yer" FontSize="14" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="HomePresetText" Text="Otomatik" FontSize="14" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="11" Margin="8,1,0,0" Foreground="{DynamicResource textTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Rectangle Height="1" Fill="{DynamicResource hairlineBrush}" Margin="10,0" />
                        <Button Style="{StaticResource RowButton}" Click="OnDisplayShortcut">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="TV'deki görünüm" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="11" Margin="8,1,0,0" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Rectangle Height="1" Fill="{DynamicResource hairlineBrush}" Margin="10,0" />
                        <Button Style="{StaticResource RowButton}" Click="OnGuideShortcut">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Rehber ve sorun giderme" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="11" Margin="8,1,0,0" Foreground="{DynamicResource textTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
