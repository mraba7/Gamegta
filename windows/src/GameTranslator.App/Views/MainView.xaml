                                        <TextBlock Text="&#x202B;تطبيق التلفزيون&#x202C;" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="&#x202B;افتح تطبيق GameTranslator على التلفزيون. يتصل بالكمبيوتر تلقائياً عبر نفس الشبكة.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
