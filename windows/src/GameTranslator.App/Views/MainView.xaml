                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="&#x202B;منطقة القراءة&#x202C;" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="&#x202B;حسب مكان الترجمة في لعبتك اختر قالباً جاهزاً من تبويب «منطقة القراءة» أو اضبط المربع الأزرق.&#x202C;" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" />
